@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<section class="auth-register-section">
    <div class="container">
        <div class="row g-0 auth-register-shell overflow-hidden">
            <div class="col-lg-5">
                <div class="auth-register-media auth-login-media">
                    <div class="auth-register-copy">
                        <span class="auth-register-eyebrow">Welcome back</span>
                        <h1>Sign in and return to your CareCompass workspace</h1>
                        <p>Access your account, review your schedule, and keep your client workflow moving with clarity and confidence.</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="auth-register-form-wrap">
                    <div class="auth-register-form-header">
                        <h2 class="mb-2">Log in</h2>
                        <p class="mb-0">Enter your email and password to continue.</p>
                    </div>

                    <form id="account" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <label asp-for="Input.Email" class="form-label">Email</label>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                            <label asp-for="Input.Password" class="form-label">Password</label>
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>
                        <div class="checkbox mb-3 auth-login-remember">
                            <label asp-for="Input.RememberMe" class="form-label">
                                <input class="form-check-input" asp-for="Input.RememberMe" />
                                @Html.DisplayNameFor(m => m.Input.RememberMe)
                            </label>
                        </div>
                        <div>
                            <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Log in</button>
                        </div>
                        <p class="auth-register-login mb-0">Don't have an account? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register</a></p>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
