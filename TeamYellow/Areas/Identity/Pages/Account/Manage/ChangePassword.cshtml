@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change Password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

@section Styles {
    <link rel="stylesheet" href="~/css/client/client-detail.css" asp-append-version="true" />
}

<div class="detail-container">
    <div class="detail-header">
        <a href="@Url.Action("Account", "User")" class="detail-back-button">
            <i class="bi bi-arrow-left"></i> Back to Account Settings
        </a>
    </div>

    <div class="detail-card">
        <!-- Card Header -->
        <div class="detail-card-header">
            <div class="detail-header-content">
                <div class="detail-avatar">
                    <i class="bi bi-key" aria-hidden="true"></i>
                </div>
                <div class="detail-header-info">
                    <h1>Change Password</h1>
                    <p>Update your account password</p>
                </div>
            </div>
        </div>

        <!-- Card Body -->
        <div class="detail-card-body">
            @await Html.PartialAsync("_AlertMessages")

            <form id="change-password-form" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <!-- Password Fields Section -->
                <div class="detail-section border-bottom-0">
                    <div class="detail-section-title">
                        <i class="bi bi-shield-lock" aria-hidden="true"></i>
                        Password Information
                    </div>

                    <div class="detail-fields-grid">
                        <div class="detail-field" style="grid-column: 1 / -1;">
                            <label asp-for="Input.OldPassword" class="detail-field-label"></label>
                            <input asp-for="Input.OldPassword" class="edit-input" autocomplete="current-password" aria-required="true" placeholder="Enter your current password" />
                            <span asp-validation-for="Input.OldPassword" class="text-danger" style="font-size: 0.85rem; margin-top: 0.25rem;"></span>
                        </div>

                        <div class="detail-field" style="grid-column: 1 / -1;">
                            <label asp-for="Input.NewPassword" class="detail-field-label"></label>
                            <input asp-for="Input.NewPassword" class="edit-input" autocomplete="new-password" aria-required="true" placeholder="Enter your new password" />
                            <span asp-validation-for="Input.NewPassword" class="text-danger" style="font-size: 0.85rem; margin-top: 0.25rem;"></span>
                        </div>

                        <div class="detail-field" style="grid-column: 1 / -1;">
                            <label asp-for="Input.ConfirmPassword" class="detail-field-label"></label>
                            <input asp-for="Input.ConfirmPassword" class="edit-input" autocomplete="new-password" aria-required="true" placeholder="Confirm your new password" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger" style="font-size: 0.85rem; margin-top: 0.25rem;"></span>
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <!-- Card Footer -->
        <div class="detail-card-footer">
            <button id="change-password-button" type="submit" form="change-password-form" class="detail-action-button detail-action-primary">
                <i class="bi bi-key" aria-hidden="true"></i>
                <span>Update Password</span>
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
