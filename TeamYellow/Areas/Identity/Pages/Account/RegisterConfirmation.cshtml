@page
@model RegisterConfirmationModel

@{
    ViewData["Title"] = "Register confirmation";
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<section class="auth-register-section">
    <div class="container">
        <div class="row g-0 auth-register-shell overflow-hidden">
            <div class="col-lg-5">
                <div class="auth-register-media auth-login-media">
                    <div class="auth-register-copy">
                        <span class="auth-register-eyebrow">Almost there</span>
                        <h1>Check your email</h1>
                        <p>Confirm your account to continue.</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="auth-register-form-wrap">
                    <div class="auth-register-form-header">
                        <h2 class="mb-2">Register confirmation</h2>
                        <p class="mb-4">
                            We’ve sent a confirmation email so you can verify your account before signing in.
                        </p>
                    </div>

                    @if (Model.DisplayConfirmAccountLink)
                    {
                        <div class="alert alert-warning mb-4" role="alert">
                            Email sending is not fully configured yet, so the confirmation link is shown below for testing.
                        </div>

                        <div class="d-grid gap-3">
                            <a id="confirm-link"
                                   href="@Model.EmailConfirmationUrl"
                                   class="btn btn-lg btn-primary">
                                Confirm email
                            </a>

                            <a asp-page="./Login" class="btn btn-lg btn-outline-secondary">
                                Back to login
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success mb-4" role="alert">
                            Please check your email and click the confirmation link to activate your account.
                        </div>

                        <div class="d-grid gap-3">
                            <a asp-page="./Login" class="btn btn-lg btn-primary">
                                Go to login
                            </a>

                            <a asp-page="/Index" asp-area="" class="btn btn-lg btn-outline-secondary">
                                Return home
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>