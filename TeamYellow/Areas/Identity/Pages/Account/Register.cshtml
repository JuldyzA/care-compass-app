@page
@model RegisterModel

<script src='https://www.google.com/recaptcha/api.js'></script>

@{
    ViewData["Title"] = "Register";
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<section class="auth-register-section">
    <div class="container">
        <div class="row g-0 auth-register-shell overflow-hidden">
            <div class="col-lg-5">
                <div class="auth-register-media">
                    <div class="auth-register-copy">
                        <span class="auth-register-eyebrow">Welcome to CareCompass</span>
                        <h1>Create your account and start with confidence</h1>
                        <p>Join a calmer, more connected workflow for practitioners. Set up your profile, organize your practice, and start building a more polished client experience.</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="auth-register-form-wrap">
                    <div class="auth-register-form-header">
                        <h2 class="mb-2">Register</h2>
                        <p class="mb-0">Fill in your details to create your CareCompass account.</p>
                    </div>

                    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Input.FirstName" class="form-control" autocomplete="given-name" aria-required="true" placeholder="First Name" />
                                    <label asp-for="Input.FirstName">First Name</label>
                                    <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Input.LastName" class="form-control" autocomplete="family-name" aria-required="true" placeholder="Last Name" />
                                    <label asp-for="Input.LastName">Last Name</label>
                                    <span asp-validation-for="Input.LastName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating">
                                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                                    <label asp-for="Input.Email">Email</label>
                                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Password" />
                                    <label asp-for="Input.Password">Password</label>
                                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirm Password" />
                                    <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="auth-register-captcha">
                            <div class="g-recaptcha" data-sitekey='@ViewData["SiteKey"]'></div>
                        </div>

                        <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Create Account</button>
                    </form>

                    <p class="auth-register-login mb-0">Already have an account? <a asp-area="Identity" asp-page="/Account/Login">Login</a></p>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
