@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
}

<div class="d-flex justify-content-center align-items-center text-center" style="min-height:70vh; flex-direction:column; gap:20px;">

    @{
        if (User.Identity?.IsAuthenticated ?? false)
        {
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                <button type="submit" class="btn btn-outline-dark">Click here to Logout</button>
            </form>
        }
        else
        {
            <div style="display:flex; justify-content:center; align-items:center;">

                <svg xmlns="http://www.w3.org/2000/svg"
                     width="72"
                     height="72"
                     viewBox="0 0 72 72">

                    <circle cx="36" cy="36" r="36" fill="var(--brand-secondary)" />

                    <g transform="translate(28,28)" fill="var(--brand-primary)">
                        <path fill-rule="evenodd"
                              d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 2h-8A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0z" />
                        <path fill-rule="evenodd"
                              d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 0 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z" />
                    </g>

                </svg>
            </div>

            <h1 style="font-size:2.5rem; font-weight:600;">
                You've been successfully logged out.
            </h1>

            <p style="font-size:1.1rem; color:#666;">
                Thank you for using CareCompass.
            </p>

            <div style="display:flex; flex-direction:column; gap:10px; justify-content:center;">

                <a asp-area="Identity"
                   asp-page="/Account/Login"
                   class="btn btn-outline-dark">
                    Log In
                </a>

                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-outline-dark">
                    Go to Home
                </a>

            </div>
        }
    }
</div>