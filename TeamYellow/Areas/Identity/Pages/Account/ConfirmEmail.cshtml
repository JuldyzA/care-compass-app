@page
@model ConfirmEmailModel

@{
    ViewData["Title"] = "Confirm email";

    var isSuccess = Model.IsSuccess;

    var alertClass = isSuccess ? "alert-success" : "alert-danger";
    var eyebrowText = isSuccess ? "Success" : "Something went wrong";
    var headingText = isSuccess
        ? "Your email has been confirmed"
        : "We couldn’t confirm your email";
    var bodyText = isSuccess
        ? "Your CareCompass account is now verified and ready to use."
        : "The confirmation link may be invalid, expired, or already used.";
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<section class="auth-register-section">
    <div class="container">
        <div class="row g-0 auth-register-shell overflow-hidden">
            <div class="col-lg-5">
                <div class="auth-register-media auth-login-media">
                    <div class="auth-register-copy">
                        <span class="auth-register-eyebrow">@eyebrowText</span>
                        <h1>@headingText</h1>
                        <p>@bodyText</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="auth-register-form-wrap">
                    <div class="auth-register-form-header">
                        <h2 class="mb-2">Email confirmation</h2>
                        <p class="mb-4">Review the confirmation result below and continue to the next step.</p>
                    </div>

                    <div class="alert @alertClass mb-4" role="alert">
                        @Model.StatusMessage
                    </div>

                    <div class="d-grid gap-3">
                        <a asp-page="./Login" class="btn btn-lg btn-primary">
                            Go to login
                        </a>

                        <a asp-controller="Home" asp-action="Index" class="btn btn-lg btn-outline-secondary">
                            Return home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>