@page
@model LockoutModel
@{
    ViewData["Title"] = "Locked out";
}

<section class="auth-register-section">
    <div class="container">
        <div class="row g-0 auth-register-shell overflow-hidden">
            <div class="col-lg-5">
                <div class="auth-register-media auth-login-media">
                    <div class="auth-register-copy">
                        <span class="auth-register-eyebrow">Account security</span>
                        <h1>Sign-in is temporarily unavailable</h1>
                        <p>
                            We noticed several unsuccessful login attempts.
                            Please wait a few minutes before trying again.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="auth-register-form-wrap">
                    <div class="auth-register-form-header">
                        <h2 class="mb-2">@ViewData["Title"]</h2>
                        <p class="mb-3">
                            For your protection, access has been temporarily restricted.
                        </p>
                    </div>

                    <div class="alert alert-warning" role="alert">
                        Please try again after the lockout period ends.
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <a asp-page="./Login" class="btn btn-primary btn-lg">Back to login</a>
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-lg">Return to home</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>