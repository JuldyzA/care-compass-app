@model TeamYellow.ViewModels.PlanVM

@{
    ViewData["Title"] = "Checkout";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Checkout</h3>
                </div>
                <div class="card-body">
                    <h4 class="card-title">@Model.PlanName</h4>
                    <p class="card-text">@Model.PlanDescription</p>
                    <hr />
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="h5">Total:</span>
                        <span class="h4 text-primary">CAD @Model.Price.ToString("F2")</span>
                    </div>

                    <form asp-controller="Subscription" asp-action="Subscribe" method="post">
                        <input type="hidden" name="planId" value="@Model.PlanId" />
                        <button type="submit" class="btn btn-warning w-100 btn-lg">
                            Pay with PayPal
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
