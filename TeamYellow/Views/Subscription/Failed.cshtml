@{
    ViewData["Title"] = "Payment Failed";
    var message = TempData["Message"] as string;
    var messageType = (TempData["MessageType"] as string) ?? "danger";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h2 class="text-danger mb-3">Payment Failed</h2>

                    <p class="mb-3">
                        Your payment could not be completed, and no subscription was activated.
                    </p>

                    @if (!string.IsNullOrWhiteSpace(message))
                    {
                        <div class="alert alert-@messageType">
                            @message
                        </div>
                    }

                    <p class="text-muted mb-4">
                        Please review your plan and payment details, then try again.
                    </p>

                    <div class="d-flex gap-2 flex-wrap">
                        <a asp-controller="Plan" asp-action="Index" class="btn btn-primary">
                            Back to Plans
                        </a>

                        <a asp-controller="Plan" asp-action="Index" class="btn btn-outline-secondary">
                            Choose Another Plan
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>