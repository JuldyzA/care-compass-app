@{
    ViewData["Title"] = "Payment Cancelled";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h2 class="text-warning mb-3">Payment Cancelled</h2>

                    <p class="mb-3">
                        Your payment was cancelled. No charge was completed, and no subscription was activated.
                    </p>

                    <p class="text-muted mb-4">
                        You can return to the plans page and try again whenever you're ready.
                    </p>

                    <div class="d-flex gap-2 flex-wrap">
                        <a asp-controller="Plan" asp-action="Index" class="btn btn-primary">
                            Back to Plans
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>