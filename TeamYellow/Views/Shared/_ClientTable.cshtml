@using TeamYellow.DTOs
@using TeamYellow.ViewModels
@model ClientTableVm

<div id ="clientTableContainer">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Client Details</h5>
        <div class="d-flex gap-2">
            <div class="input-group input-group-sm" style="width: 250px;">
                <span class="input-group-text bg-white border-end-0">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" id="sessionSearchInput" class="form-control border-start-0" placeholder="Search sessions...">
            </div>
            <button class="btn btn-sm btn-outline-secondary" type="button" id="sessionFilterBtn">
                <i class="bi bi-funnel"></i> Filter
            </button>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="sessionsTable">
                <thead class="table-light">
                    <tr>
                        <th class="sortable" data-column="patient">
                            Patient Name <i class="bi bi-chevron-expand text-muted"></i>
                        </th>
                        <th class="sortable" data-column="datetime">
                            Date & Time <i class="bi bi-chevron-expand text-muted"></i>
                        </th>
                        <th class="sortable" data-column="type">
                            Type <i class="bi bi-chevron-expand text-muted"></i>
                        </th>
                        <th class="sortable" data-column="status">
                            Status <i class="bi bi-chevron-expand text-muted"></i>
                        </th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="sessionsTableBody">
                    @* Should I use dto or vm?*@
                    @foreach (ClientDto c in Model.Clients)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="avatar-sm me-2">
                                        <span class="avatar-initial rounded-circle bg-primary">GJ</span>
                                    </div>
                                    <span class="fw-medium">@c.FirstName @c.LastName</span>
                                </div>
                            </td>
                            <td>
                                <div>Mar 12, 2026</div>
                                <small class="text-muted">10:00 AM</small>
                            </td>
                            <td><span class="badge bg-light text-dark border">Individual</span></td>
                            <td><span class="badge bg-success">Confirmed</span></td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="d-flex justify-content-between align-items-center p-3 border-top">
        <div class="text-muted small">
            Showing <span id="showingStart">1</span> to <span id="showingEnd">5</span> of <span id="totalEntries">8</span> entries
        </div>
        <nav aria-label="Sessions pagination">
            <ul class="pagination pagination-sm mb-0" id="sessionsPagination">
                <li class="page-item disabled">
                    <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
                <li class="page-item active"><a class="page-link" href="#">1</a></li>
                <li class="page-item"><a class="page-link" href="#">2</a></li>
                <li class="page-item">
                    <a class="page-link" href="#">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        loadClients();
    });

    async function loadClients(page = 1) {
        try {
            console.log(page)
            const response = await fetch(`/Counsellor/ClientTable?page=${page}`);

            if (!response.ok) throw new Error('Network response was not ok');

            const html = await response.text();
            const container = document.getElementById("clientTableContainer");

            if (container) {
                container.innerHTML = html;
            }
        } catch (error) {
            console.error("Failed to load clients:", error);
        }
    }
</script>