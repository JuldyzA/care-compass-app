@{
    bool isAdmin = User.IsInRole("Administrator");
    bool isManager = User.IsInRole("Manager");
    bool isCounsellor = User.IsInRole("Paid_Counselor") || User.IsInRole("Free_Counselor");
    bool isRegisteredVisitor = User.IsInRole("Registered_Visitor");
}

@if (isAdmin)
{
    <li>
        <a class="dropdown-item" asp-controller="Admin" asp-action="UserRoleIndex">
            <i class="bi bi-speedometer2" aria-hidden="true"></i> User Management
        </a>
    </li>
    <li>
        <a class="dropdown-item" asp-controller="Admin" asp-action="RoleIndex">
            <i class="bi bi-people" aria-hidden="true"></i> Role Management
        </a>
    </li>
    <li>
        <a class="dropdown-item" asp-controller="Admin" asp-action="UserLogAll">
            <i class="bi bi-journal-text" aria-hidden="true"></i> User Logs
        </a>
    </li>
}
else if (isManager)
{
    <li>
        <a class="dropdown-item" asp-controller="Manager" asp-action="Index">
            <i class="bi bi-speedometer2" aria-hidden="true"></i> Transactions
        </a>
    </li>
    <li>
        <a class="dropdown-item" asp-controller="Manager" asp-action="Plans">
            <i class="bi bi-card-list" aria-hidden="true"></i> Plans
        </a>
    </li>
    <li>
        <a class="dropdown-item" asp-controller="Manager" asp-action="Discounts">
            <i class="bi bi-tags" aria-hidden="true"></i> Discounts
        </a>
    </li>
}
else if (isCounsellor)
{
    <li>
        <a class="dropdown-item" asp-controller="User" asp-action="Profile">
            <i class="bi bi-person" aria-hidden="true"></i> My Profile
        </a>
    </li>
    <li>
        <a class="dropdown-item" asp-controller="Counsellor" asp-action="Clients">
            <i class="bi bi-people" aria-hidden="true"></i> Clients
        </a>
    </li>
    <li>
        <a class="dropdown-item notifications-link" asp-controller="Counsellor" asp-action="Notifications">
            <i class="bi bi-bell" aria-hidden="true"></i> Notifications
            <span class="badge bg-danger ms-2">3</span>
        </a>
    </li>
}
else if (isRegisteredVisitor)
{
    <li>
        <a class="dropdown-item" asp-controller="User" asp-action="Profile">
            <i class="bi bi-person" aria-hidden="true"></i> My Profile
        </a>
    </li>
    <li>
        <a class="dropdown-item" asp-controller="Plan" asp-action="Index">
            <i class="bi bi-credit-card" aria-hidden="true"></i> View Plans
        </a>
    </li>
}

<li><hr class="dropdown-divider"></li>
<li>
    <form method="post" asp-area="Identity" asp-page="/Account/Logout">
        <button type="submit" class="dropdown-item">
            <i class="bi bi-box-arrow-right" aria-hidden="true"></i> Logout
        </button>
    </form>
</li>