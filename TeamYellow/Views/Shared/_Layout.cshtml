<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TeamYellow</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TeamYellow.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap&subset=cyrillic" rel="stylesheet">


</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-0">
            <div class="container-fluid m-0 align-items-center">
                <div class="navbar-top-row w-100 d-flex align-items-center justify-content-between">
                    <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="~/images/compass-logo.png" alt="CareCompass Logo" height="60" class="me-2">
                        <span class="fw-bold brand-name header-logo-name">
                            <span>Care</span>
                            <span>Compass</span>
                        </span>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                </div>
                <div>
                    <div class="navbar-collapse collapse d-lg-inline-flex justify-content-around me-4">
                    <ul class="navbar-nav flex-grow-1 gap-3">
                        <li class="nav-item">
                            <a class="nav-link text-dark d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                                <img src="~/Images/nav-home.svg" alt="" class="nav-icon" aria-hidden="true">
                                <span>Home</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Solution">
                                <img src="~/Images/nav-solution.svg" alt="" class="nav-icon" aria-hidden="true">
                                <span>Solution</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark d-flex align-items-center gap-2" asp-area="" asp-controller="Plan" asp-action="Index">
                                <img src="~/Images/nav-plan.svg" alt="" class="nav-icon" aria-hidden="true">
                                <span>Plan</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <partial name="_LoginPartial" />
                        </li>
                        
                    </ul>
                    
                    </div>
                </div>
            </div>
        </nav>
    </header>
    @* <div class="container"> *@
        <main role="main" class="pb-0 flex-grow-1">
            @RenderBody()
        </main>
    @* </div> *@

   <footer class="site-footer mt-auto">
    <div class="container footer-shell">
        <div class="row g-4 align-items-start">
            <div class="col-12 col-md-6 col-lg-4 footer-brand-col">
                <a href="/" class="footer-brand text-decoration-none">
                    <img src="~/images/compass-logo-dark1.png" alt="CareCompass Logo" class="footer-brand-mark">
                    <span class="fw-bold brand-name header-logo-name footer-brand-name">
                        <span>Care</span>
                        <span>Compass</span>
                    </span>
                </a>
                <p class="footer-meta mb-1">Copyright © 2026 Care Compass</p>
                <p  class="footer-meta mb-1">By TeamYellow</p>
                <p class="footer-meta mb-1">All Rights Reserved</p>
                <p class="footer-meta footer-address mb-0">123 Main street</p>
            </div>

            <div class="col-md-6 col-lg-4 footer-nav-group">
                <h6 class="footer-title">Solution</h6>
                <ul class="footer-links">
                    <li><a href="/Home/Solution">Features</a></li>
                    <li><a href="/Plan">Pricing</a></li>
                    <li><a href="#">Case studies</a></li>
                    <li><a class="footer-accent-link" href="/#testimonials">Testimonials</a></li>
                </ul>
            </div>

            <div class="col-md-6 col-lg-4 footer-nav-group footer-social-col">
                <h6 class="footer-title">Follow us</h6>
                <ul class="footer-links footer-social-links">
                    <li><a href="https://facebook.com" target="_blank" rel="noopener noreferrer"><i class="bi bi-facebook"></i><span>Facebook</span></a></li>
                    <li><a href="https://twitter.com" target="_blank" rel="noopener noreferrer"><i class="bi bi-twitter-x"></i><span>Twitter</span></a></li>
                    <li><a href="https://instagram.com" target="_blank" rel="noopener noreferrer"><i class="bi bi-instagram"></i><span>Instagram</span></a></li>
                    <li><a href="https://linkedin.com" target="_blank" rel="noopener noreferrer"><i class="bi bi-linkedin"></i><span>LinkedIn</span></a></li>
                </ul>
            </div>

        </div>
    </div>
</footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
