@* Views/Shared/_Sidebar.cshtml *@
@{
    // Use both controller + action so "active" works even when everything is in AdminController
    var controller = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "");
    var action = (ViewContext.RouteData.Values["action"]?.ToString() ?? "");

    bool IsActive(string c, string a) =>
        controller.Equals(c, StringComparison.OrdinalIgnoreCase)
        && action.Equals(a, StringComparison.OrdinalIgnoreCase);

    bool IsActiveActionStartsWith(string c, string aPrefix) =>
        controller.Equals(c, StringComparison.OrdinalIgnoreCase)
        && action.StartsWith(aPrefix, StringComparison.OrdinalIgnoreCase);
}

@if (!User.Identity?.IsAuthenticated ?? true)
{
    @* If someone ever renders this partial while not logged in, show nothing *@
}
else if (User.IsInRole("Administrator"))
{
    <a class="@(IsActiveActionStartsWith("Admin", "UserRole") ? "active" : "")"
       asp-controller="Admin" asp-action="UserRoleIndex">
        User Management
    </a>

    <a class="@(IsActiveActionStartsWith("Admin", "Role") ? "active" : "")"
       asp-controller="Admin" asp-action="RoleIndex">
        Role Management
    </a>

    <a class="@(IsActive("Admin", "UserLogAll") ? "active" : "")"
       asp-controller="Admin" asp-action="UserLogAll">
        View Logs
    </a>
}
else if (User.IsInRole("Manager"))
{
    @* TODO: Uncomment and update code for Manager views *@
    @* <a class="@(IsActive("Manager", "Index") ? "active" : "")"
       asp-controller="Manager" asp-action="Index">
        Dashboard
    </a>

    <a class="@(IsActive("Plans", "Index") ? "active" : "")"
       asp-controller="Plans" asp-action="Index">
        Plans
    </a>

    <a class="@(IsActive("Discounts", "Index") ? "active" : "")"
       asp-controller="Discounts" asp-action="Index">
        Discounts
    </a> *@
}
else if (User.IsInRole("Paid_Counselor") || User.IsInRole("Free_Counselor"))
{
    @* TODO: Uncomment and update code for Counsellor views *@
    @* <a class="@(IsActive("Counsellor", "Index") ? "active" : "")"
       asp-controller="Counsellor" asp-action="Index">
        Dashboard
    </a>

    <a class="@(IsActive("Clients", "Index") ? "active" : "")"
       asp-controller="Clients" asp-action="Index">
        Clients
    </a> *@
}
else
{
    @* Fallback for any other authenticated role (or no role) *@
    <a class="@(IsActive("Home", "Index") ? "active" : "")"
       asp-controller="Home" asp-action="Index">
        Home
    </a>
}