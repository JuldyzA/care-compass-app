@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    var userName = UserManager.GetUserName(User) ?? "User";
    var displayName = ViewData["DisplayName"]?.ToString();
    var profilePicture = ViewData["UserProfilePicture"]?.ToString() ?? ViewData["DefaultUserProfilePicture"]?.ToString() ?? Url.Content("~/Images/placeholder-profile.jpg");

    var rawName = !string.IsNullOrWhiteSpace(displayName)
    ? displayName.Trim()
    : userName;

    bool isAdmin = User.IsInRole("Administrator");
    bool isManager = User.IsInRole("Manager");
    bool isCounsellor = User.IsInRole("Paid_Counselor") || User.IsInRole("Free_Counselor");
    bool isRegisteredVisitor = User.IsInRole("Registered_Visitor");

    string roleLabel =
        isAdmin ? "Administrator" :
        isManager ? "Manager" :
        isCounsellor ? "Counsellor" :
        isRegisteredVisitor ? "Registered Visitor" :
        "User";


    bool alreadyHasDr =
        rawName.StartsWith("Dr.", StringComparison.OrdinalIgnoreCase) ||
        rawName.StartsWith("Dr ", StringComparison.OrdinalIgnoreCase);

    string welcomeName =
        isCounsellor
            ? (alreadyHasDr ? rawName : $"Dr. {rawName}")
            : rawName;

    string headerMessage =
        isAdmin ? "Manage users, roles, and logs" :
        isManager ? "Manage plans, discounts, and payment activity" :
        isCounsellor ? "Here is the latest update of your clinic" :
        "Welcome to CareCompass";
}

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>@ViewData["Title"] - CareCompass Dashboard</title>

        <!-- Bootstrap CSS -->
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />

        <!-- Bootstrap Icons -->
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

        <!-- Custom Dashboard CSS -->
        <link rel="stylesheet" href="~/css/dashboard/dashboard-layout.css" asp-append-version="true" />

        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
        @await RenderSectionAsync("PageStyles", required: false)
        @await RenderSectionAsync("Styles", required: false)
    </head>
    <body class="@(ViewData["DisablePageScroll"] as bool? == true ? "locked-page-scroll" : "")">

        <div class="dashboard-wrapper">

            <!-- Sidebar -->
            <aside class="sidebar" id="sidebar" role="navigation" aria-label="Main navigation">
                <div class="sidebar-header">
                    <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src='@Url.Content("~/Images/compass-logo-no-bg.png")' alt="CareCompass Logo" height="60" class="me-2">
                        <span class="fw-bold brand-name header-logo-name">
                            <span>Care</span>
                            <span>Compass</span>
                        </span>
                    </a>
                </div>

                @if (SignInManager.IsSignedIn(User))
                {
                    <div class="sidebar-user-section">
                        <div class="dropdown w-100">
                            <button class="user-info-dropdown w-100" type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false" aria-label="User menu">
                                <div class="user-info">
                                    <div class="user-avatar" aria-hidden="true">
                                        <img class="sidebar-user-profile-picture" src="@profilePicture" alt="User Profile Picture" />
                                    </div>
                                    <div class="user-details">
                                        <div class="user-name">@rawName</div>
                                        <div class="user-role">@roleLabel</div>
                                    </div>
                                    <i class="bi bi-chevron-down ms-auto" aria-hidden="true"></i>
                                </div>
                            </button>

                            <ul class="dropdown-menu w-100" aria-labelledby="userMenuDropdown">
                                @await Html.PartialAsync("_DashboardUserMenuItems")
                            </ul>
                        </div>
                    </div>
                }

                @if (isCounsellor)
                {
                    @await Html.PartialAsync("_CounsellorSidebar")
                }
                else if (isRegisteredVisitor)
                {
                    @await Html.PartialAsync("_RegisteredVisitorSidebar")
                }
                else if (isAdmin)
                {
                    @await Html.PartialAsync("_AdminSidebar")
                }
                else if (isManager)
                {
                    @await Html.PartialAsync("_ManagerSidebar")
                }
            </aside>

            <!-- Toggle Button (Outside Sidebar) -->
            <button class="sidebar-toggle-inline" id="sidebarToggle" aria-label="Toggle sidebar" aria-expanded="true" aria-controls="sidebar">
                <i class="bi bi-chevron-left" aria-hidden="true"></i>
            </button>

            <!-- Main Content Area -->
            <div class="main-content">

                <div class="site-header">
                    <div class="header-content">
                        <div class="header-left">
                            <h2 class="header-welcome">Welcome back, @welcomeName!</h2>
                            <p class="header-message">@headerMessage</p>
                        </div>

                        <div class="header-right">
                            @if (SignInManager.IsSignedIn(User))
                            {
                                <div class="dropdown">
                                    <button class="header-user-dropdown" type="button" id="headerUserDropdown" data-bs-toggle="dropdown" aria-expanded="false" aria-label="User menu">
                                        <div class="header-user-info">
                                            <div class="header-user-avatar" aria-hidden="true">
                                                <img class="header-user-profile-picture" src="@profilePicture" alt="User Profile Picture" />
                                            </div>
                                            <div class="header-user-details">
                                                <div class="header-user-name">@rawName</div>
                                                <div class="header-user-role">@roleLabel</div>
                                            </div>
                                            <i class="bi bi-chevron-down ms-2" aria-hidden="true"></i>
                                        </div>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="headerUserDropdown">
                                    @await Html.PartialAsync("_DashboardUserMenuItems")
                                    </ul>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Page Content -->
                <main class="content-area" role="main" aria-label="Main content">
                    @RenderBody()
                </main>

            </div>
        </div>

        <!-- apexcharts library -->
        <script src="https://cdn.jsdelivr.net/npm/apexcharts@3.49.1/dist/apexcharts.min.js"></script>

        <!-- Bootstrap JS -->
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>

        <!-- Dashboard Scripts -->
        <script src="~/js/dashboard/dashboard-layout.js" asp-append-version="true"></script>

        @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>