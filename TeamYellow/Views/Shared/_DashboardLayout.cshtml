@using Microsoft.AspNetCore.Identity
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CareCompass</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        .dash-shell { min-height: 100vh; display: flex; background: #fff; }
        .dash-sidebar {
            width: 240px; border-right: 1px solid #eee; padding: 16px 12px;
            position: sticky; top: 0; height: 100vh;
        }
        .dash-brand { display:flex; align-items:center; gap:10px; margin-bottom: 12px; }
        .dash-brand img { width: 34px; height: 34px; }
        .dash-user { display:flex; align-items:center; gap:10px; padding: 10px 6px; margin: 10px 0 14px; }
        .dash-user .avatar { width: 36px; height: 36px; border-radius: 50%; background: #e9ecef; }
        .dash-user .name { font-weight: 600; font-size: .95rem; line-height: 1.1; }
        .dash-user .meta { font-size: .8rem; color: #6c757d; }
        .dash-nav a {
            display:block; padding: 8px 10px; border-radius: 8px; color: #212529;
            text-decoration: none;
        }
        .dash-nav a:hover { background: #f5f5f5; }
        .dash-nav .active { background: #fbe9ea; color: #b02a37; font-weight: 600; }
        .dash-main { flex: 1; }
        .dash-topbar {
            border-bottom: 1px solid #eee; padding: 12px 18px;
            display:flex; align-items:center; justify-content: space-between;
        }
        .dash-content { padding: 18px; }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="dash-shell">
        <aside class="dash-sidebar">
            <div class="dash-brand">
                <!-- Replace with your logo file -->
                <img src="~/images/carecompass-logo.png" alt="CareCompass" />
                <div>
                    <div style="font-weight:700; line-height:1;">care</div>
                    <div style="margin-top:-6px; font-weight:700; line-height:1;">compass</div>
                </div>
            </div>

            <div class="dash-user">
                <div class="avatar"></div>
                <div>
                    <div class="name">@User.Identity?.Name</div>
                    <div class="meta">
                        @(User.IsInRole("Administrator") ? "Administrator" :
                                                User.IsInRole("Manager") ? "Manager" :
                                                (User.IsInRole("Paid_Counselor") || User.IsInRole("Free_Counselor")) ? "Counsellor" : "User")
                    </div>
                </div>
            </div>

            <nav class="dash-nav">
                <partial name="_Sidebar" />
            </nav>
        </aside>

        <div class="dash-main">
            <header class="dash-topbar">
                <div>
                    <div style="font-weight:600;">Welcome Back, @(User.Identity?.Name ?? "User")</div>
                    <div style="font-size:.85rem; color:#6c757d;">Here’s your dashboard</div>
                </div>

                <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="m-0">
                    <button type="submit" class="btn btn-outline-secondary btn-sm">Log out</button>
                </form>
            </header>

            <main class="dash-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
