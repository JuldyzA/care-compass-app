@* Views/Shared/_DashboardLayout.cshtml *@
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - CareCompass Dashboard</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <!-- Custom Dashboard CSS -->
    <link href="~/css/dashboard-layout.css" rel="stylesheet" />
</head>
<body>

    <div class="dashboard-wrapper">

        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar" role="navigation" aria-label="Main navigation">
            <div class="sidebar-header">
                <div class="logo-container">
                    <i class="bi bi-compass text-primary fs-2" aria-hidden="true"></i>
                    <h4 class="logo-text mb-0">CareCompass</h4>
                </div>
            </div>

            <!-- User Info Section -->
            @if (SignInManager.IsSignedIn(User))
            {
                var userName = UserManager.GetUserName(User);
                <div class="sidebar-user-section">
                    <div class="dropdown w-100">
                        <button class="user-info-dropdown w-100" type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false" aria-label="User menu">
                            <div class="user-info">
                                <div class="user-avatar" aria-hidden="true">
                                    <img class="sidebar-user-profile-picture" src="@(ViewData["UserProfilePicture"] ?? "https://randomuser.me/api/portraits/med/men/1.jpg")" alt="User Profile Picture" />
                                    @* <i class="bi bi-person-circle fs-3"></i> *@
                                </div>
                                <div class="user-details">
                                    <div class="user-name">@userName</div>
                                    <div class="user-role">Counsellor</div>
                                </div>
                                <i class="bi bi-chevron-down ms-auto" aria-hidden="true"></i>
                            </div>
                        </button>
                        <ul class="dropdown-menu w-100" aria-labelledby="userMenuDropdown">
                            <li><a class="dropdown-item" href="/Counsellor/Profile"><i class="bi bi-person" aria-hidden="true"></i> My Profile</a></li>
                            <li><a class="dropdown-item" href="/Counsellor/Clients"><i class="bi bi-people" aria-hidden="true"></i> Clients</a></li>
                            <li>
                                <a class="dropdown-item" href="#" id="notificationsLink">
                                    <i class="bi bi-bell" aria-hidden="true"></i> Notifications
                                    <span class="badge bg-danger ms-2">3</span>
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form method="post" asp-area="Identity" asp-page="/Account/Logout">
                                    <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Logout</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            }

            <nav class="sidebar-nav" aria-label="Dashboard navigation">
                <ul class="nav flex-column" role="list">
                    <li class="nav-item" role="listitem">
                        <a class="nav-link" href="/Counsellor" data-page="dashboard" aria-current="page">
                            <i class="bi bi-speedometer2" aria-hidden="true"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li class="nav-item" role="listitem">
                        <a class="nav-link" href="/Counsellor/Clients" data-page="clients">
                            <i class="bi bi-people" aria-hidden="true"></i>
                            <span>Clients</span>
                        </a>
                    </li>
                    <li class="nav-item" role="listitem">
                        <a class="nav-link" href="/Counsellor/Appointments" data-page="appointments">
                            <i class="bi bi-calendar-check" aria-hidden="true"></i>
                            <span>Appointments</span>
                        </a>
                    </li>
                </ul>

                <div class="sidebar-divider" role="separator"></div>

                <ul class="nav flex-column" role="list">
                    <li class="nav-item" role="listitem">
                        <a class="nav-link" href="/Counsellor/Billing" data-page="billing">
                            <i class="bi bi-credit-card" aria-hidden="true"></i>
                            <span>Billing</span>
                        </a>
                    </li>
                    <li class="nav-item" role="listitem">
                        <a class="nav-link" href="/Counsellor/Upgrade" data-page="upgrade">
                            <i class="bi bi-arrow-up-circle" aria-hidden="true"></i>
                            <span>Upgrade</span>
                        </a>
                    </li>
                </ul>

                <div class="sidebar-divider" role="separator"></div>

                <ul class="nav flex-column" role="list">
                    <li class="nav-item" role="listitem">
                        <a class="nav-link" href="/Counsellor/Profile" data-page="profile">
                            <i class="bi bi-person-circle" aria-hidden="true"></i>
                            <span>Profile</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </aside>

        <!-- Toggle Button (Outside Sidebar) -->
        <button class="sidebar-toggle-inline" id="sidebarToggle" aria-label="Toggle sidebar" aria-expanded="true" aria-controls="sidebar">
            <i class="bi bi-chevron-left" aria-hidden="true"></i>
        </button>

        <!-- Main Content Area -->
        <div class="main-content">

            <!-- Page Content -->
            <main class="content-area" role="main" aria-label="Main content">
                @RenderBody()
            </main>

        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Dashboard Scripts -->
    <script src="~/js/dashboard-layout.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>