@using TeamYellow.ViewModels

@model UserAccountVM

@{
    ViewData["Title"] = "Account Settings";
}

<div class="detail-container">
    <div class="detail-header">
        <a class="detail-back-button" asp-controller="Counsellor" asp-action="Index">
            <i class="bi bi-chevron-left" aria-hidden="true"></i>
            <span>Back</span>
        </a>
    </div>

    <div class="detail-card">
        <!-- Card Header -->
        <div class="detail-card-header">
            <div class="detail-header-content">
                <div class="detail-avatar">
                    <i class="bi bi-shield-lock" aria-hidden="true"></i>
                </div>
                <div class="detail-header-info">
                    <h1>Account Settings</h1>
                    <p>Manage your login credentials</p>
                </div>
            </div>
        </div>

        <!-- Card Body -->
        <div class="detail-card-body">
            <div class="detail-section">
                <h2 class="detail-section-title">
                    <i class="bi bi-key" aria-hidden="true"></i>
                    Login Credentials
                </h2>

                <div class="detail-fields-grid">
                    <div class="detail-field">
                        <label class="detail-field-label">Email Address</label>
                        <div class="detail-field-value">
                            @Model.Email
                        </div>
                    </div>

                    <div class="detail-field">
                        <label class="detail-field-label">Password</label>
                        <div class="detail-field-value">
                            @Model.MaskedPassword
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card Footer -->
        <div class="detail-card-footer">
            <a asp-area="Identity" asp-page="/Account/Manage/ChangePassword" class="detail-action-button detail-action-primary">
                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                <span>Change Password</span>
            </a>
        </div>
    </div>
</div>