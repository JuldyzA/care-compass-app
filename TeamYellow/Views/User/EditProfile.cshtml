@using TeamYellow.ViewModels
@model UserProfileVM

@{
    ViewData["Title"] = "Edit Profile";
    bool isCounsellor = User.IsInRole("Paid_Counselor") || User.IsInRole("Free_Counselor");
}

@section Styles {
    <link rel="stylesheet" href="~/css/client/client-detail.css" asp-append-version="true" />
}

<div class="detail-container">
    <div class="detail-header">
        <a href="@Url.Action("Profile", "User")" class="detail-back-button">
            <i class="bi bi-arrow-left"></i> Back to Profile
        </a>
    </div>

    <div class="detail-card">
        <!-- Profile Header -->
        <div class="detail-card-header">
            <div class="detail-header-content">
                <div class="detail-avatar">
                    @if (!string.IsNullOrEmpty(Model.ProfilePhotoUrl))
                    {
                        <img src="@Model.ProfilePhotoUrl" 
                             alt="@Model.FullName" 
                             class="profile-avatar-img" 
                             style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;" 
                             onerror="this.style.display='none'; this.parentElement.textContent=this.alt.charAt(0).toUpperCase() + (this.alt.split(' ')[1] ? this.alt.split(' ')[1].charAt(0).toUpperCase() : '');" />
                    }
                    else
                    {
                        @Model.FirstName.FirstOrDefault().ToString().ToUpper()@Model.LastName.FirstOrDefault().ToString().ToUpper()
                    }
                </div>
                <div class="detail-header-info">
                    <h1>@Model.FullName</h1>
                    <p>@Model.Email</p>
                </div>
            </div>
        </div>

        <!-- Details Body -->
        <div class="detail-card-body">

            @await Html.PartialAsync("_AlertMessages")

            <form method="post" asp-action="EditProfile" asp-controller="User" id="editProfileForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserProfileId" />

                <!-- Contact Information Section -->
                <div class="detail-section">
                    <div class="detail-section-title">
                        <i class="bi bi-envelope"></i> Contact Information
                    </div>
                    <div class="detail-fields-grid">
                        <div class="detail-field">
                            <label asp-for="FirstName" class="detail-field-label">First Name *</label>
                            <input asp-for="FirstName" class="edit-input" placeholder="Enter your first name" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="detail-field">
                            <label asp-for="LastName" class="detail-field-label">Last Name *</label>
                            <input asp-for="LastName" class="edit-input" placeholder="Enter your last name" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                        @if (isCounsellor)
                        {
                            <div class="detail-field">
                                <label asp-for="DisplayName" class="detail-field-label">Display Name</label>
                                <input asp-for="DisplayName" class="edit-input" placeholder="e.g., John Smith" />
                                <span asp-validation-for="DisplayName" class="text-danger small"></span>
                            </div>
                        }
                        <div class="detail-field">
                            <label asp-for="Phone" class="detail-field-label">Phone Number</label>
                            <input asp-for="Phone" class="edit-input" placeholder="e.g., 604-555-0123" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Address Information Section -->
                <div class="detail-section">
                    <div class="detail-section-title">
                        <i class="bi bi-geo-alt"></i> Address Information
                    </div>
                    <div class="detail-fields-grid">
                        <div class="detail-field" style="grid-column: 1 / -1;">
                            <label asp-for="Street" class="detail-field-label">Street Address</label>
                            <input asp-for="Street" class="edit-input" placeholder="e.g., 123 Burrard St" />
                            <span asp-validation-for="Street" class="text-danger small"></span>
                        </div>
                        <div class="detail-field">
                            <label asp-for="UnitNumber" class="detail-field-label">Unit Number</label>
                            <input asp-for="UnitNumber" type="number" class="edit-input" placeholder="e.g., 101" />
                            <span asp-validation-for="UnitNumber" class="text-danger small"></span>
                        </div>
                        <div class="detail-field">
                            <label asp-for="City" class="detail-field-label">City</label>
                            <input asp-for="City" class="edit-input" placeholder="e.g., Vancouver" />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>
                        <div class="detail-field">
                            <label asp-for="Province" class="detail-field-label">Province</label>
                            <select asp-for="Province" class="edit-input">
                                <option value="">-- Select Province --</option>
                                <option value="AB">Alberta (AB)</option>
                                <option value="BC">British Columbia (BC)</option>
                                <option value="MB">Manitoba (MB)</option>
                                <option value="NB">New Brunswick (NB)</option>
                                <option value="NL">Newfoundland and Labrador (NL)</option>
                                <option value="NS">Nova Scotia (NS)</option>
                                <option value="NT">Northwest Territories (NT)</option>
                                <option value="NU">Nunavut (NU)</option>
                                <option value="ON">Ontario (ON)</option>
                                <option value="PE">Prince Edward Island (PE)</option>
                                <option value="QC">Quebec (QC)</option>
                                <option value="SK">Saskatchewan (SK)</option>
                                <option value="YT">Yukon (YT)</option>
                            </select>
                            <span asp-validation-for="Province" class="text-danger small"></span>
                        </div>
                        <div class="detail-field">
                            <label asp-for="PostalCode" class="detail-field-label">Postal Code</label>
                            <input asp-for="PostalCode" class="edit-input" placeholder="e.g., V5K 0A1" />
                            <span asp-validation-for="PostalCode" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Profile Photo Section -->
                <div class="detail-section" id="profile-photo-detail-section">
                    <div class="detail-section-title">
                        <i class="bi bi-image"></i> Profile Photo
                    </div>
                    <div class="detail-fields-grid">
                        <div class="detail-field" style="grid-column: 1 / -1;">
                            <label asp-for="ProfilePhotoUrl" class="detail-field-label">Profile Photo URL</label>
                            <input asp-for="ProfilePhotoUrl" class="edit-input" placeholder="https://example.com/photo.jpg" />
                            <small style="color: #6c757d; font-size: 0.8rem;">Provide a URL to your profile photo image.</small>
                            <span asp-validation-for="ProfilePhotoUrl" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <!-- Action Buttons - Outside Form/Body -->
        <div class="detail-card-footer">
            <button type="submit" form="editProfileForm" class="detail-action-button detail-action-primary">
                <i class="bi bi-check-circle"></i> Save Changes
            </button>
            <a href="@Url.Action("Profile", "User")" class="detail-action-button detail-action-secondary">
                <i class="bi bi-x-circle"></i> Cancel
            </a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}