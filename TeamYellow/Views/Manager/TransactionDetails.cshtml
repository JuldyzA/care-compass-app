@using Microsoft.EntityFrameworkCore.Metadata.Internal
@using System.Security.Claims
@model TeamYellow.ViewModels.ManagerDashboardVM


<h4>Transaction Details</h4>
<div>
    <p><strong>Transaction ID:</strong> @Model.PaymentTransactionId</p>
    <p><strong>Paid Date:</strong> @Model.PaidAt</p>
    <p><strong>Amount:</strong> @Model.Amount</p>
    <p><strong>Status:</strong> @Model.SOP</p>
    <p><strong>Practitioner Licence ID:</strong> @Model.PractitionerLicenceId</p>
    <p>
        <strong>Counsellor:</strong>
        @Model.CounsellorName
    </p>
    <p><strong>Email:</strong> @Model.Email</p>
    <p><strong>Registration Date:</strong> @Model.RegistrationDate</p>
</div>
<a asp-action="Index" class="btn btn-secondary">Back</a>
