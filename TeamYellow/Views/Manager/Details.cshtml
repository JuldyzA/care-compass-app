@using Microsoft.EntityFrameworkCore.Metadata.Internal
@using System.Security.Claims
@model TeamYellow.ViewModels.ManagerDashboardVM


<div class="container-fluid">
    <div class="row">
        @await Html.PartialAsync("_ManagerSideBar", Model)
        <!-- Summary Cards -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card shadow-sm p-3 text-center">
                    <small>Total Counsellors</small>
                    <h5>vm.Stats.TotalTransactions</h5>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm p-3 text-center">
                    <small>Total Revenue</small>
                    <h5>vm.Stats.TotalRevanue</h5>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm p-3 text-center">
                    <small>Paid Transactions</small>
                    <h5>vm.Stats.SuccessfulPayments</h5>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm p-3 text-center">
                    <small>Failed Transactions</small>
                    <h5>vm.Stats.FailedPayments</h5>
                </div>
            </div>
        </div>

        <div class="card mb-4 p-4">
            <h6>Charts Area</h6>
            <p>Later you can add Chart.js here.</p>
        </div>

        <!-- Main Content -->
        <main class="col-md-10 p-4">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4>Welcome Back, @(User.Identity?.Name ?? "Manager Name")</h4>
                <button class="btn btn-outline-primary btn-sm">Sign Out</button>
            </div>

            <!-- Transactions Table -->
            <div class="card p-3">
                <h5 class="mb-3">Transaction Details</h5>
                <div>
                    <p><strong>Transaction ID:</strong> @Model.PaymentTransactionId</p>
                    <p><strong>Paid Date:</strong> @Model.PaidAt</p>
                    <p><strong>Amount:</strong> @Model.Amount</p>
                    <p><strong>Status:</strong> @Model.SOP</p>
                    <p><strong>Practitioner Licence ID:</strong> @Model.PractitionerLicenceId</p>
                    <p>
                        <strong>Counsellor:</strong>
                        @Model.CounsellorName
                    </p>
                    <p><strong>Email:</strong> @Model.Email</p>
                    <p><strong>Registration Date:</strong> @Model.RegistrationDate</p>
                </div>
                <a asp-action="Index" class="btn btn-secondary">Back</a>
            </div>

        </main>
    </div>
</div>
