@model TeamYellow.ViewModels.DiscountVM

@{
    ViewData["Title"] = "Edit Discount";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="EditDiscount" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="DiscountId" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="DiscountCode" class="form-label"></label>
        <input asp-for="DiscountCode" class="form-control" readonly />
        <span asp-validation-for="DiscountCode" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DiscountType" class="form-label"></label>
        <input asp-for="DiscountType" class="form-control" readonly />
        <span asp-validation-for="DiscountType" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Value" class="form-label"></label>
        <input asp-for="Value" class="form-control" type="number" readonly />
        <span asp-validation-for="Value" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="StartDateTime" class="form-label"></label>

        @if (Model.IsStarted && !Model.IsExpired)
        {
            <input asp-for="StartDateTime"
                   type="datetime-local"
                   class="form-control"
                   asp-format="{0:yyyy-MM-ddTHH:mm}"
                   readonly />

            <small class="text-warning">
                Start date cannot be changed because the discount has already started.
            </small>
        }
        else
        {
            <input asp-for="StartDateTime"
                   type="datetime-local"
                   class="form-control"
                   asp-format="{0:yyyy-MM-ddTHH:mm}" />
        }

        <span asp-validation-for="StartDateTime" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EndDateTime" class="form-label"></label>
        <input asp-for="EndDateTime"
               type="datetime-local"
               class="form-control"
               asp-format="{0:yyyy-MM-ddTHH:mm}" />
        <span asp-validation-for="EndDateTime" class="text-danger"></span>
    </div>

    @if (Model.IsExpired)
    {
        <div class="alert alert-warning">
            This discount has expired. To activate it again, please set new start and end dates.
        </div>
    }
    else if (Model.IsStarted)
    {
        <div class="alert alert-warning">
            This discount is currently active. You can only modify the end date.
        </div>
    }
    else
    {
        <div class="alert alert-info">
            You can modify the start and end dates of this discount.
        </div>
    }

    <div class="mb-3">
        <label class="form-label">Plans</label>
        <span asp-validation-for="PlanIds" class="text-danger d-block"></span>

        @if (Model.AvailablePlans != null)
        {
            foreach (var plan in Model.AvailablePlans)
            {
                <div class="form-check">
                    <input class="form-check-input"
                           type="checkbox"
                           name="PlanIds"
                           value="@plan.Value"
                           id="plan_@plan.Value"
                    @(plan.Selected ? "checked" : "")
                    @(Model.IsStarted && !Model.IsExpired ? "disabled" : "") />

                    <label class="form-check-label" for="plan_@plan.Value">
                        @plan.Text
                    </label>
                </div>
            }
        }
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Discounts" class="btn btn-secondary ms-2">Cancel</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}