@model TeamYellow.ViewModels.ApplyDiscountVM

<h4>Apply Discount</h4>

<form asp-action="ApplyDiscount" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="DiscountId" class="form-label">Select Discount</label>
        <select asp-for="DiscountId"
                asp-items="Model.DiscountCodeOptions"
                class="form-select">
            <option value="">-- Select Discount --</option>
        </select>
        <span asp-validation-for="DiscountId" class="text-danger"></span>
    </div>

    <h5>Select Plans</h5>
    <span asp-validation-for="PlanIds" class="text-danger d-block mb-2"></span>

    @if (Model.Plans != null)
    {
        foreach (var plan in Model.Plans)
        {
            <div class="form-check mb-2">
                <input type="checkbox"
                       id="plan-@plan.PlanId"
                       name="PlanIds"
                       value="@plan.PlanId"
                       class="form-check-input"
                       @(Model.PlanIds.Contains(plan.PlanId) ? "checked" : "") />

                <label class="form-check-label" for="plan-@plan.PlanId">
                    @plan.PlanName - $@plan.Price.ToString("0.00")
                </label>
            </div>
        }
    }

    <button type="submit" class="btn btn-primary mt-3">Save</button>
    <a asp-action="Discounts" class="btn btn-secondary mt-3 ms-2">Cancel</a>
</form>