@using Microsoft.EntityFrameworkCore.Metadata.Internal
@using System.Security.Claims
@model IEnumerable<TeamYellow.ViewModels.ManagerDashboardVM>

<div class="container-fluid">
    <div class="row">

        <!-- Sidebar -->
        @await Html.PartialAsync("_ManagerSideBar", Model)

        <!-- Main Content -->
        <main class="col-md-10 p-4">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4>Welcome Back, @(User.Identity?.Name ?? "Manager")</h4>
                <button class="btn btn-outline-primary btn-sm">Sign Out</button>
            </div>

            <!-- Summary Cards -->
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="card shadow-sm p-3 text-center">
                        <small>Total Counsellors</small>
                        @* <h5>@vm.Stats.TotalTransactions</h5> *@
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card shadow-sm p-3 text-center">
                        <small>Total Revenue</small>
                        @* <h5>@vm.Stats.TotalRevanue</h5> *@
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card shadow-sm p-3 text-center">
                        <small>Paid Transactions</small>
                        @* <h5>@vm.Stats.SuccessfulPayments</h5> *@
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card shadow-sm p-3 text-center">
                        <small>Failed Transactions</small>
                        @* <h5>@vm.Stats.FailedPayments</h5> *@
                    </div>
                </div>
            </div>

            <!-- Chart Placeholder -->
            <div class="card mb-4 p-4">
                <h6>Charts Area</h6>
                <p>Later you can add Chart.js here.</p>
            </div>

            <!-- Transactions Table -->
            <div class="card p-3">
                <h5 class="mb-3">Transactions</h5>

                <table class="table table-striped table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Counsellor ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Currency</th>                          
                            <th>Amount</th>
                            <th>Transaction Status</th>
                            <th>Payment Date</th>
                            <th>Details</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var vm in Model)
                        {
                            <tr>
                                <td>@vm.CounsellorId</td>
                                <td>@vm.CounsellorName</td>
                                <td>@vm.Email</td>
                                <th>@vm.Currency</th>                              
                                <td>@vm.Amount</td>                               
                                <td>@vm.SOP</td>
                                <td>@vm.PaidAt</td>
                                <td>
                                    <a class="btn btn-sm btn-primary"
                                       asp-controller="Manager"
                                       asp-action="Details"
                                       asp-route-id="@vm.PaymentTransactionId">
                                        Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>

        </main>
    </div>
</div>
