@model TeamYellow.ViewModels.ManagerDashboardPageVM
@using System.Globalization

@{
    var currencyCulture = new CultureInfo("en-CA");
}

<!-- Summary Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm p-3 text-center">
            <small>Total Transactions</small>
            <h5>@Model.Stats.TotalTransactions</h5>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm p-3 text-center">
            <small>Total Revenue</small>
            <h5>@Model.Stats.TotalRevenue.ToString("C", currencyCulture)</h5>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm p-3 text-center">
            <small>Paid Transactions</small>
            <h5>@Model.Stats.SuccessfulPayments</h5>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm p-3 text-center">
            <small>Failed Transactions</small>
            <h5>@Model.Stats.FailedPayments</h5>
        </div>
    </div>
</div>

<!-- Chart Placeholder -->
<div class="card mb-4 p-4">
    <h6>Charts Area</h6>
    <p>Later you can add Chart.js here.</p>
</div>
           
<form method="get" asp-action="Index" class="mb-3">

    <div class="row g-2 align-items-end">

        <div class="col-md-3">
            <label>Email</label>
            <input type="text"
                    name="searchEmail"
                    value="@Context.Request.Query["searchEmail"]"
                    class="form-control"
                    placeholder="Search by email..." />
        </div>

        <div class="col-md-3">
            <label>Start Date</label>
            <input type="date"
                    name="startDate"
                    value="@Context.Request.Query["startDate"]"
                    class="form-control" />
        </div>

        <div class="col-md-3">
            <label>End Date</label>
            <input type="date"
                    name="endDate"
                    value="@Context.Request.Query["endDate"]"
                    class="form-control" />
        </div>

        <div class="col-md-3">
            <button type="submit" class="btn btn-primary me-2">
                Search
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Reset
            </a>
        </div>

    </div>

</form>
<!-- Transactions Table -->
<h4>Transactions</h4>
    <table class="table table-striped table-hover">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Plan Type</th>                
                <th>Amount</th>
                <th>Status</th>
                <th>Payment Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>

            @if (Model.Counsellors != null && Model.Counsellors.Any())
            {
                foreach (var vm in Model.Counsellors)
                {
                    <tr>
                        <td>@vm.CounsellorName</td>
                        <td>@vm.Email</td>
                        <td>@vm.BillingType</td>
                        <td>@vm.Amount.ToString("C", currencyCulture)</td>
                        <td>@vm.SOP</td>
                        <td>@vm.PaidAt?.ToString("yyyy-MM-dd")</td>

                        <td>
                            <a class="btn btn-sm btn-primary"
                                asp-controller="Manager"
                                asp-action="TransactionDetails"
                                asp-route-id="@vm.PaymentTransactionId">
                                Details
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted">
                        No transactions found for the selected filters.
                    </td>
                </tr>
            }

        </tbody>
    </table>
