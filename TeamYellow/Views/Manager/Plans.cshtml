@using Microsoft.EntityFrameworkCore.Metadata.Internal
@using System.Security.Claims
@model TeamYellow.ViewModels.PlanVM

<h4>Plans</h4>

<table class="table table-striped table-hover">
    <thead class="table-light">
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Price</th>
            <th>Billing Type</th>
            <th>Status</th>
            <th>Created</th>
            <th>Edit</th>


        </tr>
    </thead>

    <tbody>
        @foreach (var plan in Model.Plans)
        {
            <tr>
                <td>@plan.PlanName</td>
                <td>@plan.PlanDescription</td>
                <td>@plan.Price.ToString("0.00")</td>
                <td>@plan.BillingType</td>
                <td>@(plan.IsActive ? "Active" : "Inactive")</td>
                <td>@plan.CreatedAt.ToString("yyyy-MM-dd")</td>
                <td>
                    @if(plan.BillingType != "Free")
                    {
                    <a class="btn btn-sm btn-primary"
                        asp-controller="Manager"
                        asp-action="PlanEdit"
                        asp-route-id="@plan.PlanId">
                        Edit
                    </a>                                     
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

