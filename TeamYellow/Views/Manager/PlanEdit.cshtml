@using Microsoft.EntityFrameworkCore.Metadata.Internal
@using System.Security.Claims
@model TeamYellow.ViewModels.PlanVM

<div class="container-fluid">
    <div class="row">

        <!-- Sidebar -->
        @await Html.PartialAsync("_ManagerSideBar")

        <!-- Main Content -->
        <main class="col-md-10 p-4">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4>Edit Plan</h4>
            </div>

            <!-- Edit Plan Card -->
            <div class="card p-4">

                <form asp-action="PlanEdit" method="post">

                    <input type="hidden" asp-for="PlanId" />

                    <div class="mb-3">
                        <label class="form-label">Plan Name</label>
                        <input asp-for="PlanName" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea asp-for="PlanDescription" class="form-control"></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Price</label>
                        <input asp-for="Price" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Billing Type</label>
                        <select asp-for="BillingType"
                                asp-items="@(new SelectList(ViewBag.BillingTypes))"
                                class="form-select">
                        </select>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label class="form-check-label">Active</label>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">
                            Save Changes
                        </button>

                        <a asp-action="Plans" class="btn btn-secondary ms-2">
                            Cancel
                        </a>
                    </div>

                </form>

            </div>

        </main>
    </div>
</div>