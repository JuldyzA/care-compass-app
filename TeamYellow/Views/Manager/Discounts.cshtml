@using System.Security.Claims
@model TeamYellow.ViewModels.DiscountVM

<div class="container-fluid">
    <div class="row">

        <!-- Sidebar -->
        @await Html.PartialAsync("_ManagerSideBar", Model)

        <!-- Main Content -->
        <main class="col-md-10 p-4">

            <!-- Transactions Table -->
            <div class="card p-3">
                <h5 class="mb-3">Discounts</h5>

                <div class="mb-3 d-flex gap-2">
                    <a href="@Url.Action("ApplyDiscount", "Manager")" class="btn btn-primary">Apply Code</a>
                    <a href="@Url.Action("CreateDiscount", "Manager")" class="btn btn-success">Create Code</a>
                </div>

                <table class="table table-striped table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Discount Code</th>
                            <th>Discount Type</th>
                            <th>Value</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Created</th>
                            <th>Applyed To</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Discounts != null)
                        {
                            foreach (var d in Model.Discounts)
                            {
                                <tr>
                                    <td>@d.DiscountCode</td>
                                    <td>@d.DiscountType</td>
                                    <td>@d.Value</td>
                                    <td>@d.StartDateTime.ToString("yyyy-MM-dd")</td>
                                    <td>@d.EndDateTime.ToString("yyyy-MM-dd")</td>
                                    <td>@d.CreatedAt.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        @if (d.PlanDiscounts != null && d.PlanDiscounts.Any())
                                        {
                                            
                                                @foreach (var pd in d.PlanDiscounts)
                                                {
                                                    
                                                        <span class="badge bg-info text-dark me-1">
                                                            @pd.Plan.PlanName
                                                        </span>
                                                    
                                                }
                                           
                                        }
                                        else
                                        {
                                            <span>No plans</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

                <div class="mt-3">
                    <a href="javascript:history.back()" class="btn btn-secondary">Back</a>
                </div>
            </div>

        </main>
    </div>
</div>
