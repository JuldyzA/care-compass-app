@model TeamYellow.ViewModels.DiscountVM

@{
    ViewData["Title"] = "Delete Discount";
}

<h1>@ViewData["Title"]</h1>

<p>Are you sure you want to delete this discount?</p>

<ul>
    <li><strong>Code:</strong> @Model.DiscountCode</li>
    <li><strong>Value:</strong> @Model.Value</li>
</ul>

@if (Model.HasPlans)
{
    <div class="alert alert-danger">
        This discount is currently applied to plans and cannot be deleted.
    </div>

    <a asp-action="Discounts" class="btn btn-secondary">Back to Discounts</a>
}
else
{
    <form asp-action="DeleteDiscountConfirmed" method="post">
        <input type="hidden" name="id" value="@Model.DiscountId" />

        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Discounts" class="btn btn-secondary">Back to Discounts</a>
    </form>
}

