@using TeamYellow.ViewModels
@model CounsellorBillingVM

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Billing";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard/billing.css" asp-append-version="true" />
}

<div class="m-3">
    @await Html.PartialAsync("_AlertMessages")
</div>

<div class="billing-header mb-4">
    <h1 class="page-title">
        <i class="bi bi-credit-card me-2"></i>Billing & Transactions
    </h1>
    <p class="page-subtitle">View and manage your subscription payments</p>
</div>

@if (Model.IsSubscriptionActive && Model.CurrentCycleEnd.HasValue)
{
    <div class="alert alert-info alert-with-icon" role="alert">
        <i class="bi bi-info-circle-fill"></i>
        <div>
            <strong>Active Subscription</strong>
            <p class="mb-0">Your subscription is valid until <strong>@Model.CurrentCycleEnd.Value.ToString("MMMM dd, yyyy")</strong></p>
        </div>
    </div>
}

<div class="billing-summary-cards">
    <div class="summary-card">
        <div class="card h-100">
            <div class="card-body">
                <div class="summary-icon">
                    <i class="bi bi-cash-coin"></i>
                </div>
                <h5 class="card-title">Total Spent</h5>
                <div class="summary-value">
                    @if (Model.TotalSpent > 0)
                    {
                        <span class="amount">@Model.TotalSpent.ToString("C")</span>
                    }
                    else
                    {
                        <span class="amount">$0.00</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="summary-card">
        <div class="card h-100">
            <div class="card-body">
                <div class="summary-icon">
                    <i class="bi bi-receipt"></i>
                </div>
                <h5 class="card-title">Total Transactions</h5>
                <div class="summary-value">
                    <span class="amount">@Model.TotalTransactions</span>
                </div>
            </div>
        </div>
    </div>

    <div class="summary-card">
        <div class="card h-100">
            <div class="card-body">
                <div class="summary-icon">
                    <i class="bi bi-shield-check"></i>
                </div>
                <h5 class="card-title">Status</h5>
                <div class="summary-value">
                    @if (Model.IsSubscriptionActive)
                    {
                        <span class="status-badge status-active">Active</span>
                    }
                    else
                    {
                        <span class="status-badge status-inactive">Inactive</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="transactions-section">
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="bi bi-clock-history me-2"></i>Transaction History
            </h5>
        </div>

        <div class="card-body">
            @if (Model.Transactions.Count == 0)
            {
                <div class="empty-state">
                    <i class="bi bi-inbox empty-state-icon"></i>
                    <h6>No Transactions Yet</h6>
                    <p class="text-muted">Once you subscribe to a plan, your transactions will appear here.</p>
                    <a asp-controller="Plan" asp-action="Index" class="btn btn-primary btn-sm mt-2">
                        Browse Plans
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="transactions-table table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date & Time</th>
                                <th>Plan Name</th>
                                <th>Billing Type</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Provider</th>
                                <th class="text-end">Details</th>
                            </tr>
                        </thead>
                        <tbody id="transactionsTableBody">
                            @foreach (var transaction in Model.Transactions.OrderByDescending(t => t.PaidAt))
                            {
                                <tr class="transaction-row">
                                    <td>
                                        <div class="transaction-date">
                                            @transaction.PaidAt.ToString("MMM dd, yyyy")
                                        </div>
                                        <small class="text-muted">@transaction.PaidAt.ToString("hh:mm tt")</small>
                                    </td>
                                    <td>
                                        <span class="fw-medium">@transaction.PlanName</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark">
                                            @transaction.BillingType
                                        </span>
                                    </td>
                                    <td>
                                        <div class="amount-text">
                                            @transaction.Amount.ToString("C")
                                        </div>
                                        <small class="text-muted">@transaction.Currency</small>
                                    </td>
                                    <td>
                                        @{
                                            var statusClass = transaction.Status == "Paid" ? "status-paid" : "status-failed";
                                            var statusIcon = transaction.Status == "Paid" ? "check-circle" : "x-circle";
                                        }
                                        <span class="status-badge @statusClass">
                                            <i class="bi bi-@statusIcon"></i>
                                            @transaction.Status
                                        </span>
                                    </td>
                                    <td>
                                        <small>@transaction.Provider</small>
                                    </td>
                                    <td class="text-end">
                                        <button type="button" 
                                                class="btn btn-sm btn-outline-primary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#transactionModal_@transaction.PaymentTransactionId"
                                                aria-label="View transaction details"
                                                title="View Details">
                                            <i class="bi bi-eye"></i> View
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @if (Model.Transactions.Count > 0)
        {
            <div class="pagination-footer">
                <div class="text-muted small">
                    Showing <span id="showingStart">1</span> to <span id="showingEnd">@Model.Transactions.Count</span> of <span id="totalEntries">@Model.Transactions.Count</span> entries
                </div>
            </div>
        }
    </div>
</div>

<div class="billing-footer-info">
    <p class="mb-0">
        <i class="bi bi-shield-lock me-2"></i>
        All transactions are securely processed through PayPal. 
        If you have any questions about your billing, please contact our support team.
    </p>
</div>

<!-- Transaction Details Modals - Placed outside tbody -->
@foreach (var transaction in Model.Transactions)
{
    <div class="modal fade" id="transactionModal_@transaction.PaymentTransactionId" tabindex="-1" aria-labelledby="transactionModalLabel_@transaction.PaymentTransactionId" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="transactionModalLabel_@transaction.PaymentTransactionId">
                        Transaction Details
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="transaction-details">
                        <div class="detail-row">
                            <span class="detail-label">Order ID:</span>
                            <span class="detail-value font-monospace">@transaction.ProviderOrderId</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Plan:</span>
                            <span class="detail-value">@transaction.PlanName</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Billing Type:</span>
                            <span class="detail-value">@transaction.BillingType</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Amount:</span>
                            <span class="detail-value">@transaction.Amount.ToString("C") @transaction.Currency</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Payment Date:</span>
                            <span class="detail-value">@transaction.PaidAt.ToString("MMMM dd, yyyy hh:mm tt")</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Status:</span>
                            <span class="detail-value">
                                @{
                                    var statusClass = transaction.Status == "Paid" ? "text-success" : "text-danger";
                                }
                                <span class="@statusClass">
                                    <strong>@transaction.Status</strong>
                                </span>
                            </span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Provider:</span>
                            <span class="detail-value">@transaction.Provider</span>
                        </div>
                        @if (transaction.CycleStart.HasValue && transaction.CycleEnd.HasValue)
                        {
                            <div class="detail-row">
                                <span class="detail-label">Coverage Period:</span>
                                <span class="detail-value">
                                    @transaction.CycleStart.Value.ToString("MMM dd, yyyy") - @transaction.CycleEnd.Value.ToString("MMM dd, yyyy")
                                </span>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize tooltips if using Bootstrap tooltips
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
}