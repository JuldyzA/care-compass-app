@model TeamYellow.ViewModels.ClientVM

@{
    ViewData["Title"] = "Create Client";
}

@section Styles {
    <link rel="stylesheet" href="~/css/form.css" asp-append-version="true" />
}

<div class="form-container">
    <div class="form-card">
        <div class="form-card-body">
            <h4 class="form-card-title">New Client</h4>

            @await Html.PartialAsync("_AlertMessages")

            <form asp-action="CreateClient" asp-controller="Counsellor" method="post" class="create-client-form">
                @Html.AntiForgeryToken()

                <div class="form-section">
                    <div class="form-row">
                        <div class="form-field-group">
                            <label asp-for="FirstName" class="form-field-label"></label>
                            <input asp-for="FirstName" class="form-field-input" />
                            <span asp-validation-for="FirstName" class="form-field-error"></span>
                        </div>

                        <div class="form-field-group">
                            <label asp-for="LastName" class="form-field-label"></label>
                            <input asp-for="LastName" class="form-field-input" />
                            <span asp-validation-for="LastName" class="form-field-error"></span>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <div class="form-row">
                        <div class="form-field-group form-field-full">
                            <label asp-for="Email" class="form-field-label"></label>
                            <input asp-for="Email" class="form-field-input" />
                            <span asp-validation-for="Email" class="form-field-error"></span>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <div class="form-row">
                        <div class="form-field-group form-field-full">
                            <label asp-for="Phone" class="form-field-label"></label>
                            <input asp-for="Phone" class="form-field-input" />
                            <span asp-validation-for="Phone" class="form-field-error"></span>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <div class="form-row">
                        <div class="form-field-group form-field-full">
                            <label class="form-field-label">Client Status</label>
                            <div class="form-status-group">
                                <input asp-for="Status" class="form-status-input" type="radio" id="StatusTrue" value="true" autocomplete="off" />
                                <label class="form-status-label" for="StatusTrue">Active</label>

                                <input asp-for="Status" class="form-status-input" type="radio" id="StatusFalse" value="false" autocomplete="off" />
                                <label class="form-status-label" for="StatusFalse">Inactive</label>
                            </div>
                            <span asp-validation-for="Status" class="form-field-error"></span>
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="form-button form-button-primary">Create</button>
                    <a asp-action="Clients" asp-controller="Counsellor" class="form-button form-button-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}