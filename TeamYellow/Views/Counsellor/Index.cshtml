@using TeamYellow.ViewModels
@model TeamYellow.ViewModels.CounsellorDashboardVM

@{
    bool isLockedDashboard = User.IsInRole("Registered_Visitor");

    Layout = "_DashboardLayout";
    ViewData["UserProfilePicture"] = Model.ProfilePhotoUrl;
    ViewData["DisplayName"] = Model.DisplayName;
    ViewData["DisablePageScroll"] = isLockedDashboard;
    
    // To VM
    int total = Model.TotalSubscriptionDays;
    int remainder = Model.RemainingSubscriptionDays;
    double percentageRemaining = 0;
    bool isHealthy = false;
    if (total > 0)
    {
        percentageRemaining = Math.Round((remainder * 100.0) / total, 2);
        isHealthy = percentageRemaining > 20;
    }
    string gaugeColor = isHealthy ? "#2ECC71" : "#E74C3C";
    string textColorClass = isHealthy ? "text-success" : "text-danger";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard/index.css" asp-append-version="true" />
}

<div class="dashboard-preview-wrapper">
    <div class="dashboard-content-area">
        <div class="dashboard-content @(isLockedDashboard ? "locked-dashboard" : "")" @(isLockedDashboard ? "aria-hidden=\"true\" inert" : "")>
            <div class="stats-row">
                <div class="stats-card">
                    <div class="card">
                        <div class="card-body p-0">
                            <div class="card-stats-header">
                                <div>
                                    <div class="text-secondary">Sessions This Month</div>
                                    <div class="h1 mb-0">12</div>
                                </div>
                                <div class="text-success">+12%</div>
                            </div>
                            <div id="monthlySessionsChart"></div>
                        </div>
                    </div>
                </div>

                <div class="stats-card">
                    <div class="card">
                        <div class="card-body p-0">
                            <div class="card-stats-header">
                                <div>
                                    <div class="text-secondary">Completed This Month</div>
                                    <div class="h1 mb-0">43</div>
                                </div>
                                <div class="text-success">+52%</div>
                            </div>
                            <div id="monthlyCompletedSessionsChart"></div>
                        </div>
                    </div>
                </div>

                <div class="stats-card">
                    <div class="card">
                        <div class="card-body p-0">
                            <div class="card-stats-header">
                                <div>
                                    <div class="text-secondary">Cancelled This Month</div>
                                    <div class="h1 mb-0">22</div>
                                </div>
                                <div class="text-danger">-12%</div>
                            </div>
                            <div id="monthlyCancelledSessionChart"></div>
                        </div>
                    </div>
                </div>

                <div class="stats-card">
                    <div class="card">
                        <div class="card-body p-0">
                            <div class="card-stats-header">
                                <div>
                                    <div class="text-secondary">New Patient This Month</div>
                                    <div class="h1 mb-0">@Model.MonthlyClientCounts[11]</div>
                                </div>
                                <div class="@(Model.ClientGrowthFromLastMonth >= 0 ? "text-success" : "text-danger")">
                                    @Model.ClientGrowthFromLastMonth<span>%</span>
                                </div>
                            </div>
                            <div id="monthlyNewClientChart"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="dashboard-grid">
                <div class="dashboard-grid-left">
                    <div class="card">
                        <div class="card-body p-0">
                            <div class="m-3" id="mainSummaryChart"></div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-body p-0">
                            <div class="m-3" id="sessionHeatMap"></div>
                        </div>
                    </div>

                    <div class="card">
                        @if (isLockedDashboard)
                        {
                            <div class="p-4">
                                <h5 class="mb-3">Client Details</h5>
                                <p class="text-muted mb-0">Activate a plan to view and manage client records.</p>
                            </div>
                        }
                        else
                        {
                            @await Html.PartialAsync("_ClientTable", new ClientTableVm())
                        }
                    </div>
                </div>

                <div class="dashboard-grid-right">
                    <div class="card">
                        <div class="card-body p-0">
                            <div class="m-3" id="sessionPieChart"></div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-body p-0">
                            <div class="m-3" id="patientStatusPieChart"></div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-body p-0">
                            <div id="planUsageGauge"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (isLockedDashboard)
        {
            <div class="dashboard-lock-overlay">
                <div class="dashboard-lock-modal"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="dashboard-lock-title"
                     tabindex="-1"
                     id="dashboard-lock-modal">
                    <h5 id="dashboard-lock-title">Please activate your plan / renew your subscription</h5>

                    <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center mt-4">
                        <a asp-controller="Plan" asp-action="Index" class="btn btn-primary">
                            Select a Plan
                        </a>

                        <form method="post" asp-area="Identity" asp-page="/Account/Logout">
                            <button type="submit" class="btn btn-outline-secondary">
                                Logout
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="footer-banner @(isLockedDashboard ? "locked-footer-banner" : "")">
        <p class="@textColorClass mb-0">
            <i class="bi bi-@(isHealthy ? "check-circle-fill" : "exclamation-triangle-fill") me-2"></i>
            Your plan is ending in @Model.RemainingSubscriptionDays days
        </p>
    </div>
</div>


<!-- Back to Top Button -->
<button class="back-to-top" id="backToTopBtn" aria-label="Back to top" title="Back to top">
    <i class="bi bi-arrow-up"></i>
</button>

