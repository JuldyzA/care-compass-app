                                    },
                                    value: {
                                        fontSize: "20px",
                                        offsetY: 65
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    breakpoint: 768,
                    options: {
                        chart: {
                            height: 280
                        },
                        plotOptions: {
                            radialBar: {
                                dataLabels: {
                                    name: {
                                        fontSize: "13px",
                                        offsetY: 90
                                    },
                                    value: {
                                        fontSize: "18px",
                                        offsetY: 60
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    breakpoint: 576,
                    options: {
                        chart: {
                            height: 250
                        },
                        plotOptions: {
                            radialBar: {
                                dataLabels: {
                                    name: {
                                        fontSize: "12px",
                                        offsetY: 80
                                    },
                                    value: {
                                        fontSize: "16px",
                                        offsetY: 55
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        };

        const monthlySessionsChart = new ApexCharts(
            document.querySelector("#monthlySessionsChart"),
            monthlySessionsOptions
        );
        const monthlyCompletedSessionsChart = new ApexCharts(
            document.querySelector("#monthlyCompletedSessionsChart"),
            monthlyCompletedSessionsOptions
        );
        const monthlyCancelledSessionChart = new ApexCharts(
            document.querySelector("#monthlyCancelledSessionChart"),
            monthlyCancelledSessionOptions
        );
        const monthlyNewClientChart = new ApexCharts(
            document.querySelector("#monthlyNewClientChart"),
            monthlyNewClientOptions
        );
        const mainSummaryChart = new ApexCharts(
            document.querySelector("#mainSummaryChart"), 
            mainSummaryChartOptions
        );
        const sessionPieChart = new ApexCharts(
            document.querySelector("#sessionPieChart"),
            sessionPieChartOptions
        );
        const sessionHeatMap = new ApexCharts(
            document.querySelector("#sessionHeatMap"),
            sessionHeatMapOptions
        );
        const patientStatusPieChart = new ApexCharts(
            document.querySelector("#patientStatusPieChart"),
            patientStatusPieChartOptions
        );
        const planUsageGauge = new ApexCharts(
            document.querySelector("#planUsageGauge"),
            planUsageGaugeOptions
        );

        monthlySessionsChart.render();
        monthlyCompletedSessionsChart.render();
        monthlyCancelledSessionChart.render();
        monthlyNewClientChart.render();
        mainSummaryChart.render();
        sessionPieChart.render();
        sessionHeatMap.render();
        patientStatusPieChart.render();
        planUsageGauge.render();

        // Listen for sidebar toggle events and resize charts
        let sidebarToggleTimeout;
        window.addEventListener('sidebar-toggled', function() {
            clearTimeout(sidebarToggleTimeout);
            sidebarToggleTimeout = setTimeout(() => {
                // Resize all charts using updateOptions
                if (typeof sessionPieChart !== 'undefined') {
                    sessionPieChart.updateOptions({
                        chart: {
                            width: '100%'
                        }
                    }, true, true);
                }
                if (typeof patientStatusPieChart !== 'undefined') {
                    patientStatusPieChart.updateOptions({
                        chart: {
                            width: '100%'
                        }
                    }, true, true);
                }
                if (typeof mainSummaryChart !== 'undefined') {
                    mainSummaryChart.updateOptions({}, true, true);
                }
                if (typeof planUsageGauge !== 'undefined') {
                    planUsageGauge.updateOptions({}, true, true);
                }
                
                if (typeof sessionHeatMap !== 'undefined') {
                    const newSeries = [
                        generatePatientData("Sunday"),
                        generatePatientData("Saturday"),
                        generatePatientData("Friday"),
                        generatePatientData("Thursday"),
                        generatePatientData("Wednesday"),
                        generatePatientData("Tuesday"),
                        generatePatientData("Monday"),
                    ];
                    sessionHeatMap.updateSeries(newSeries, true);
                }
            }, 100);
        });

        // Also handle window resize events
        let chartResizeTimeout;
        window.addEventListener('resize', function() {
            clearTimeout(chartResizeTimeout);
            chartResizeTimeout = setTimeout(() => {
                if (typeof sessionPieChart !== 'undefined') {
                    sessionPieChart.updateOptions({
                        chart: {
                            width: '100%'
                        }
                    }, true, true);
                }
                if (typeof sessionHeatMap !== 'undefined') {
                    sessionHeatMap.updateOptions({}, true, true);
                }
                if (typeof patientStatusPieChart !== 'undefined') {
                    patientStatusPieChart.updateOptions({
                        chart: {
                            width: '100%'
                        }
                    }, true, true);
                }
                if (typeof mainSummaryChart !== 'undefined') {
                    mainSummaryChart.updateOptions({}, true, true);
                }
                if (typeof planUsageGauge !== 'undefined') {
                    planUsageGauge.updateOptions({}, true, true);
                }
            }, 200);
        });

        function generatePatientData(dayName) {
            const months = monthsStartingFromNow;
            let data = [];

            months.forEach(function (month) {
                // Generate 4 weeks for each month
                for (let week = 1; week <= 4; week++) {
                    data.push({
                        x: `${month} W${week}`,
                        y: Math.floor(Math.random() * 16),
                    });
                }
            });

            return {
                name: dayName,
                data: data,
            };
        }


        // ===== Back to Top Button Functionality =====
        const backToTopBtn = document.getElementById('backToTopBtn');

        // Show/hide button based on scroll position
        window.addEventListener('scroll', () => {
            if (window.scrollY > 300) {
                backToTopBtn.classList.add('show');
            } else {
                backToTopBtn.classList.remove('show');
            }
        });

        // Scroll to top smoothly when clicked
        backToTopBtn.addEventListener('click', () => {
            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        });
    </script>
@if (!isLockedDashboard)
    {
        <script src="~/js/dashboard/client-table.js" asp-append-version="true"></script>
    }
