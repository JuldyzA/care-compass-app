@model TeamYellow.ViewModels.CounsellorDashboardVM

@{
    Layout = "_DashboardLayout";
    ViewData["UserProfilePicture"] = Model.ProfilePhotoUrl;
    ViewData["DisplayName"] = Model.DisplayName;
}

<div class="row">
    <div class="col-sm-6 col-md-6 col-lg-3">
        <div class="card">
            <div class="card-body p-0">
                <div class="d-flex align-items-center p-4 pt-2 pb-0 justify-content-between">
                    <div>
                        <div class="text-secondary">Sessions This Month</div>
                        <div class="h1 mb-0">12</div>
                    </div>
                    <div class="text-success">
                        +12%
                    </div>
                </div>
                <div id="monthlySessionsChart"></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-6 col-lg-3">
        <div class="card">
            <div class="card-body p-0">
                <div class="d-flex align-items-center p-4 pt-2 pb-0 justify-content-between">
                    <div>
                        <div class="text-secondary">Completed This Month</div>
                        <div class="h1 mb-0">43</div>
                    </div>
                    <div class="text-success">
                        +52%
                    </div>
                </div>
                <div id="monthlyCompletedSessionsChart"></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-6 col-lg-3">
        <div class="card">
            <div class="card-body p-0">
                <div class="d-flex align-items-center p-4 pt-2 pb-0 justify-content-between">
                    <div>
                        <div class="text-secondary">Cancelled This Month</div>
                        <div class="h1 mb-0">22</div>
                    </div>
                    <div class="text-danger">
                        -12%
                    </div>
                </div>
                <div id="monthlyCancelledSessionChart"></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-6 col-lg-3">
        <div class="card">
            <div class="card-body p-0">
                <div class="d-flex align-items-center p-4 pt-2 pb-0 justify-content-between">
                    <div>
                        <div class="text-secondary">New Patient This Month</div>
                        <div class="h1 mb-0">@Model.MonthlyClientCounts[11]</div>
                    </div>
                    <div class="@(Model.ClientGrowthFromLastMonth >= 0 ? "text-success" : "text-danger")">
                        @Model.ClientGrowthFromLastMonth%
                    </div>
                </div>
                <div id="monthlyNewClientChart"></div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-sm-12 col-md-12 col-lg-8">
        <div class="card">
            <div class="card-body p-0">
                <div class="m-3" id="mainSummaryChart"></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-6 col-lg-4">
        <div class="card">
            <div class="card-body p-0">
                <div class="m-3" id="sessionPieChart"></div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-sm-12 col-md-12 col-lg-8">
        <div class="card">
            <div class="card-body p-0">
                <div class="m-3" id="sessionHeatMap"></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-6 col-lg-4">
        <div class="card">
            <div class="card-body p-0">
                <div class="m-3" id="patientStatusPieChart"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>

        const now = new Date();
        const currentMonthFull = now.toLocaleString('default', { month: 'long' });

        const monthsStartingFromNow = Array.from({ length: 12 }, (_, i) => {
                const date = new Date();
                date.setMonth(now.getMonth() + i + 1);
                return date.toLocaleString('default', { month: 'long' });
        });


        // Sessions This Month Option
        const monthlySessionsOptions = {
            chart: {
                type: 'area',
                height: 100,
                sparkline: {
                    enabled: true
                },
            },

            grid: {
                padding: {
                    top: -100,
                    bottom: -10
                }
            },

            series: [{
                name: 'Sessions',
                data: [18,32,20,28,26,30,74,18,32,20,28,26]
            }],

            xaxis: {
                categories: monthsStartingFromNow
            },

            stroke: {
                curve: 'smooth',
                width: 2
            },

            fill: {
                type: "gradient",
                gradient: {
                    shadeIntensity: 1,
                    opacityFrom: 0.4,
                    opacityTo: 0.1
                }
            },

            tooltip: {
                enabled: true
            },

            colors: ['#206bc4'],
        };

        // Monthly Completed Sessions Option
        const monthlyCompletedSessionsOptions = {
            chart: {
                type: 'area',
                height: 100,
                sparkline: {
                    enabled: true
                },
            },

            grid: {
                padding: {
                    top: -100,
                    bottom: -10
                }
            },

            series: [{
                name: 'Completed Sessions',
                data: [42, 11, 85, 3, 56, 78, 24, 99, 15, 67, 30, 49]
            }],

            xaxis: {
                categories: monthsStartingFromNow
            },

            stroke: {
                curve: 'smooth',
                width: 2
            },

            fill: {
                type: "gradient",
                gradient: {
                    shadeIntensity: 1,
                    opacityFrom: 0.4,
                    opacityTo: 0.1
                }
            },

            tooltip: {
                enabled: true
            },

            colors: ['#1da1f2']
        };

        // Monthly Cancelled Session Option
        const monthlyCancelledSessionOptions = {
            chart: {
                type: 'area',
                height: 100,
                sparkline: {
                    enabled: true
                },
            },

            grid: {
                padding: {
                    top: -100,
                    bottom: -10
                }
            },

            series: [{
                name: 'Cancelled Session',
                data: [29, 84, 13, 57, 92, 4, 38, 71, 10, 66, 45, 98]
            }],

            xaxis: {
                categories: monthsStartingFromNow
            },

            stroke: {
                curve: 'smooth',
                width: 2
            },

            fill: {
                type: "gradient",
                gradient: {
                    shadeIntensity: 1,
                    opacityFrom: 0.4,
                    opacityTo: 0.1
                }
            },

            tooltip: {
                enabled: true
            },

            colors: ['#667eea']
        };

        // Monthly New Client Option
        const monthlyNewClientOptions = {
            chart: {
                type: 'area',
                height: 100,
                sparkline: {
                    enabled: true
                },
            },

            grid: {
                padding: {
                    top: -100,
                    bottom: -10
                }
            },

            series: [{
                name: 'New Clients',
                data: @Html.Raw(Json.Serialize(Model.MonthlyClientCounts))
            }],

            xaxis: {
                categories: monthsStartingFromNow
            },

            stroke: {
                curve: 'smooth',
                width: 2
            },

            fill: {
                type: "gradient",
                gradient: {
                    shadeIntensity: 1,
                    opacityFrom: 0.4,
                    opacityTo: 0.1
                }
            },

            tooltip: {
                enabled: true
            },

            colors: ['#4299e1']
        };

        // Main Chart
        const mainSummaryChartOptions = {
            series: [
                { name: "Grace Johnson", data: [40, 47, 55, 55, 59, 64, 70, 78, 84, 90, 98], color: "#00E396" },
                { name: "Emily Clark", data: [37, 47, 48, 61, 59, 66, 75, 74, 84, 92, 89], color: "#2E93fA" },
                { name: "Isabella Perez", data: [57, 59, 53, 54, 42, 40, 37, 28, 33, 29, 25], color: "#FEB019" },
                { name: "Chloe Lee", data: [86, 65, 63, 58, 52, 43, 44, 32, 30, 25, 23], color: "#FF4560" },
                { name: "Clinic Average", type: "area", data: [50, 52, 53, 57, 57, 59, 61, 63, 65, 69, 70], color: "#a1a8b0" },
            ],
            chart: {
                height: 500,
                type: "line",
                zoom: { enabled: true },
                toolbar: { 
                    show: true,
                    offsetY: -5 
                },
            },
            stroke: {
                width: [4, 4, 4, 4, 2],
                curve: "smooth",
                dashArray: [0, 0, 0, 0, 5],
            },
            legend: { 
                position: "top", 
                horizontalAlign: "left", 
                fontSize: '14px',
                fontWeight: 600,
                offsetY: 0,
                offsetX: -10,
                itemMargin: {
                    horizontal: 5,
                    vertical: 0
                }
            },
            grid: {
                padding: {
                    top: 25,      
                    left: 20,
                    right: 20
                }
            },
            annotations: {
                yaxis: [
                    { y: 85, borderColor: "#00E396", borderWidth: 2, label: { text: "Discharge Readiness", style: { color: "#fff", background: "#00E396" } } },
                    { y: 30, borderColor: "#FF4560", borderWidth: 2, label: { text: "Urgent Review Req.", style: { color: "#fff", background: "#FF4560" } } },
                ],
                xaxis: [
                    { x: new Date("2024-03-01").getTime(), strokeDashArray: 3, label: { text: "Phase 2 Start", style: { background: "#775DD0", color: "#fff" } } },
                ],
            },
            fill: {
                type: ["solid", "solid", "solid", "solid", "gradient"],
                gradient: { opacityFrom: 0.3, opacityTo: 0.1 },
            },
            labels: ["2024-01-10", "2024-01-20", "2024-02-01", "2024-02-15", "2024-02-22", "2024-03-01", "2024-03-05", "2024-03-10", "2024-03-15", "2024-03-25", "2024-04-01"],
            xaxis: { type: "datetime" },
            yaxis: {
                max: 100,
                title: {
                    text: "Wellness Score %",
                    rotate: -90,
                    offsetX: 10, 
                    style: { fontSize: "16px", fontWeight: 900, color: "#263238" },
                },
                labels: {
                    style: { fontSize: "12px", fontWeight: 600, colors: ["#475569"] },
                },
            },
            tooltip: { shared: true, theme: "dark" },
            responsive: [
                {
                    breakpoint: 768, 
                    options: {
                        chart: {
                            height: 450 
                        },
                        legend: {
                            position: "bottom", 
                            offsetX: 0,
                            offsetY: 7
                        },
                        grid: {
                            padding: {
                                top: 5,
                                right: 5,  
                                bottom: 5, 
                                left: 0   
                            }
                        },
                        tooltip: { show: false },
                        yaxis: {
                            labels: {
                                show: false 
                            }
                        }
                    }
                }
            ]
        };

        // Session Summary Pie
        const sessionPieChartOptions = {
            title: {
                text: "Patient Session Overview",
                align: "left", 
                style: {
                    fontSize: "20px",
                    fontWeight: "bold",
                    color: "#333",
                },
                margin: 10, 
            },

            series: [43, 22, 8, 5],

            labels: [
                "Completed Sessions",
                "Cancelled Sessions",
                "No Show",
                "Rescheduled",
            ],

            chart: {
                type: "donut",
                height: 450,
            },

            colors: ["#2ECC71", "#E74C3C", "#F1C40F", "#3498DB"],

            plotOptions: {
                pie: {
                    donut: {
                        labels: {
                            show: true,
                            total: {
                                show: true,
                                label: "Total Sessions",
                                formatter: function (w) {
                                    return w.globals.seriesTotals.reduce(
                                        (a, b) => a + b,
                                        0,
                                    );
                                },
                            },
                        },
                    },
                },
            }
        };

        // Session heat map
        const sessionHeatMapOptions = {
            series: [
                generatePatientData("Sunday"),
                generatePatientData("Saturday"),
                generatePatientData("Friday"),
                generatePatientData("Thursday"),
                generatePatientData("Wednesday"),
                generatePatientData("Tuesday"),
                generatePatientData("Monday"),
            ],

            chart: {
                height: 230,
                type: "heatmap",
                toolbar: { show: false },
                animations: { enabled: false },
            },

            dataLabels: {
                enabled: false,
            },

            colors: ["#4AD0FF"],
            plotOptions: {
                heatmap: {
                    enableShades: false,
                    radius: 2,
                    useFillColorAsStroke: false,
                    colorScale: {
                        ranges: [
                            {
                                from: 0,
                                to: 0,
                                color: "#ebedf0",
                                name: "0",
                            },
                            {
                                from: 1,
                                to: 3,
                                color: "#B2EDFF",
                                name: "low",
                            },
                            {
                                from: 4,
                                to: 7,
                                color: "#7ADFFF",
                                name: "medium",
                            },
                            {
                                from: 8,
                                to: 11,
                                color: "#4AD0FF",
                                name: "high",
                            },
                            {
                                from: 12,
                                to: 100,
                                color: "#0099CC",
                                name: "very high",
                            },
                        ],
                    },
                },
            },

            stroke: {
                width: 2,
                colors: ["#fff"],
            },

            title: {
                text: "Patient Sessions Heatmap",
                align: "left",
                style: { fontSize: "14px", color: "#666" },
            },

            xaxis: {
                type: "category",
                position: "top",
                axisBorder: { show: false },
                axisTicks: { show: false },
                labels: {
                    show: true,
                    rotate: 0,
                    style: { fontSize: "10px" },
                    formatter: (val) => (val.includes("W1") ? val.split(" ")[0] : ""),
                },
            },

            yaxis: {
                labels: {
                    show: true,
                    style: { fontSize: "10px" },
                },
            },

            grid: {
                padding: {
                    right: 10,
                    left: 10,
                },
            },

            legend: {
                show: false,
            },

            tooltip: {
                x: {
                    show: true,
                    formatter: (val) => val,
                },
                y: {
                    formatter: (val) => `${val} sessions`,
                },
            },
        };
        
        // Patient status pie chart
        var patientStatusPieChartOptions = {
            title: {
                text: "Patient Status Distribution",
                align: "left",
                style: {
                    fontSize: "20px",
                    fontWeight: "bold",
                    color: "#333",
                },
                margin: 10,
            },

            series: @Html.Raw(Json.Serialize(Model.ActiveClientCount)),

            chart: {
                width: 450,
                type: "pie",
            },

            labels: ["Active Patients", "Inactive Patients"],
            colors: ["#00E396", "#FF4560"],
            responsive: [
                {
                    breakpoint: 480,
                    options: {
                        chart: {
                            width: 200,
                        },
                        legend: {
                            position: "bottom",
                        },
                    },
                },
            ],
        };


        const monthlySessionsChart = new ApexCharts(
            document.querySelector("#monthlySessionsChart"),
            monthlySessionsOptions
        );
        const monthlyCompletedSessionsChart = new ApexCharts(
            document.querySelector("#monthlyCompletedSessionsChart"),
            monthlyCompletedSessionsOptions
        );
        const monthlyCancelledSessionChart = new ApexCharts(
            document.querySelector("#monthlyCancelledSessionChart"),
            monthlyCancelledSessionOptions
        );
        const monthlyNewClientChart = new ApexCharts(
            document.querySelector("#monthlyNewClientChart"),
            monthlyNewClientOptions
        );
        const mainSummaryChart = new ApexCharts(
            document.querySelector("#mainSummaryChart"), 
            mainSummaryChartOptions
        );
        const sessionPieChart = new ApexCharts(
            document.querySelector("#sessionPieChart"),
            sessionPieChartOptions
        );
        const sessionHeatMap = new ApexCharts(
            document.querySelector("#sessionHeatMap"),
            sessionHeatMapOptions
        );
        const patientStatusPieChart = new ApexCharts(
            document.querySelector("#patientStatusPieChart"),
            patientStatusPieChartOptions
        );

        monthlySessionsChart.render();
        monthlyCompletedSessionsChart.render();
        monthlyCancelledSessionChart.render();
        monthlyNewClientChart.render();
        mainSummaryChart.render();
        sessionPieChart.render();
        sessionHeatMap.render();
        patientStatusPieChart.render();

        function generatePatientData(dayName) {
            const months = monthsStartingFromNow;
            let data = [];

            months.forEach(function (month) {
                // Generate 4 weeks for each month
                for (let week = 1; week <= 4; week++) {
                    data.push({
                        x: `${month} W${week}`,
                        y: Math.floor(Math.random() * 16),
                    });
                }
            });

            return {
                name: dayName,
                data: data,
            };
        }

    </script>
}
