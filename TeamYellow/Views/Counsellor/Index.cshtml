@section Scripts {
    <script>

        const now = new Date();
        const currentMonthFull = now.toLocaleString('default', { month: 'long' });

        const monthsStartingFromNow = Array.from({ length: 12 }, (_, i) => {
                const date = new Date();
                date.setMonth(now.getMonth() + i + 1);
                return date.toLocaleString('default', { month: 'long' });
        });

        // Sessions This Month Option
        const monthlySessionsOptions = {
            chart: {
                type: 'area',
                height: 100,
                sparkline: {
                    enabled: true
                },
            },

            grid: {
                padding: {
                    top: -100,
                    bottom: -10
                }
            },

            series: [{
                name: 'Sessions',
                data: [18,32,20,28,26,30,74,18,32,20,28,26]
            }],

            xaxis: {
                categories: monthsStartingFromNow
            },

            stroke: {
                curve: 'smooth',
                width: 2
            },

            fill: {
                type: "gradient",
                gradient: {
                    shadeIntensity: 1,
                    opacityFrom: 0.4,
                    opacityTo: 0.1
                }
            },

            tooltip: {
                enabled: true
            },

            colors: ['#206bc4'],
        };

        // Monthly Completed Sessions Option
