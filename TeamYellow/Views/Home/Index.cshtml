@{
    ViewData["Title"] = "Home Page";
}

<!-- Hero Section -->
<section class="hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-5 col-md-6">
                <h1>Grow your <span class="hero-italic-accent">mental health</span> practice with confidence</h1>
                <p>The all-in-one practice management software trusted by hundreds of practitioners to organize services, streamline operations, and provide a secure, professional client experience.</p>
                <div class="d-flex flex-wrap gap-3">
                    <a class="btn btn-primary" asp-controller="Plan" asp-action="Index">Start Free Trial</a>
                    <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Solution">Take a Product Tour</a>
                </div>
            </div>
            <div class="col-lg-7 col-md-6 mt-4 mt-md-0">
                <img src="images/heroImg.png" alt="CareCompass dashboard preview" class="img-fluid hero-image" />
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="features-section">
    <div class="container">
        <div class="section-header">
            <h2>Powerful Features for Every Practitioner</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-card">
                    <img src="images/profileManagement.png" alt="Profile Management" />
                    <h3>Profile Management</h3>
                    <p>Keep your profile professional and up-to-date. Add your license, specialties, expertise, and a short bio to let clients and colleagues know who you are.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <img src="images/documentation&Forms.png" alt="Documentation & Forms" />
                    <h3>Documentation & Forms</h3>
                    <p>Easily create, send, and manage intake forms, consent documents, and session notes. Clients can securely complete forms online, accessible directly in your dashboard.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <img src="images/practitionerDashboard.png" alt="Practitioner Dashboard" />
                    <h3>Practitioner Dashboard</h3>
                    <p>Organize your client information, track sessions, and manage notes for individual, couples, or family sessions—all in one place.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Video Section -->
<section class="video-section">
    <div class="container">
        <div class="section-header">
            <h2>Work with clients seamlessly</h2>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="video-wrapper">
                    <video controls preload="metadata" poster="@Url.Content("~/Images/video-poster.png")" aria-label="CareCompass plan overview video">
                         <source src="@Url.Content("~/Images/compass-video.mp4")" type="video/mp4" />
                    </video>

                </div>
            </div>
        </div>
    </div>
</section>

<!-- Audience Section -->
<section class="audience-section">
    <div class="container">
        <div class="section-header">
            <h2>CareCompass works for diverse professionals</h2>
            <p>Designed for mental health professionals, from independent counselors to large practices and partnered organizations.</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="audience-card">
                    <img src="images/independentPractitioners.png" alt="Independent practitioners" />
                    <div class="audience-card-overlay">
                        <h3>Independent Practitioners</h3>
                        <p>Whether your individual practice sees clients in person or virtually, CareCompass streamlines admin so you can focus on what matters—your clients.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="audience-card">
                    <img src="images/establishedPractices.png" alt="Established Practices" />
                    <div class="audience-card-overlay">
                        <h3>Established Practices</h3>
                        <p>Streamline operations across multiple practitioners, track payments, and maintain a professional standard for every client interaction.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="audience-card">
                    <img src="images/otherHealthProviders.png" alt="Other Health Providers" />
                    <div class="audience-card-overlay">
                        <h3>Other Health Providers</h3>
                        <p>Expanding beyond mental health—chiropractors, RMTs, Reiki practitioners, and doulas will soon have flexible documentation options.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Testimonials Section -->
<section id="testimonials" class="testimonials-section">
    <div class="container">
        <div class="section-header">
            <h2>Trusted by practitioners</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="testimonial-card">
                    <img src="images/dr.EmilyChen.png" alt="Dr. Emily Chen" />
                    <p>"CareCompass has completely transformed the way I manage my practice. Client intake, session notes, and payments are all in one secure dashboard."</p>
                    <h3>Dr. Emily Chen</h3>
                    <span class="role">RCC at Wellness Initiative</span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="testimonial-card">
                    <img src="images/michaelPatel.png" alt="Michael Patel" />
                    <p>"I love how easy it is to track session data and client forms. The dashboard is intuitive, and my clients love the professional feel."</p>
                    <h3>Michael Patel</h3>
                    <span class="role">Counsellor at Holistic Health</span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="testimonial-card">
                    <img src="images/saraGomez.png" alt="Sara Gomez" />
                    <p>"The booking system and client note organization save me hours every week. Highly recommend for any mental health practice."</p>
                    <h3>Sara Gomez</h3>
                    <span class="role">Independent Counselor</span>
                </div>
            </div>
        </div>
    </div>
</section>
