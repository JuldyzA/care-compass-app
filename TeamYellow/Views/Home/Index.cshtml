@{
    ViewData["Title"] = "Home Page";
}

<section class="row align-items-center my-5">
    <div class="col-md-5">
        <h1>Grow your mental health practice with confidence</h1>
        <p>CareCompass is the all-in-one practice management software trusted by hundreds of practitioners to organize their services, streamline operations, and provide a secure, professional experience for clients.</p>
        <div class="row mt-3">
            <a class="btn btn-primary col-md-5 me-2" href="#">Start Free Trial</a>
            <a class="btn btn-outline-primary col-md-5" href="#">Take a Product Tour</a>
        </div>
    </div>
    <div class="col-md-7 text-center">
        <img src="images/heroImg.png" alt="CareCompass dashboard preview" class="img-fluid rounded" />
    </div>
</section>

<section class="bg-light w-100 py-5">
    <div class="container">
    <h2 class="text-center mb-5">Powerful Features for Every Practitioner</h2>
    <div class="row text-center">
        <div class="col-md-4 mb-4">
                <img src="images/profileManagement.png" alt="Profile Management" class="mb-3" width="150" height="150" />
            <h3>Profile Management</h3>
            <p class="text-start">Keep your profile professional and up-to-date. Add your license, specialties, expertise, and a short bio to let clients and colleagues know who you are.</p>
        </div>
        <div class="col-md-4 mb-4">
                <img src="images/documentation&Forms.png" alt="Documentation & Forms" class="mb-3" width="150" height="150" />
                <h3>Documentation & Forms</h3>
                <p class="text-start">Easily create, send, and manage intake forms, consent documents, and session notes. Clients can securely complete forms online, and all files are accessible directly in your dashboard.</p>
        </div>
        <div class="col-md-4 mb-4">
                <img src="images/practitionerDashboard.png" alt="Practitioner Dashboard" class="mb-3" width="150" height="150" />
            <h3>Practioner Dashboard</h3>
            <p class="text-start">Organize your client information, track sessions, and manage notes for individual, couples, or family sessions—all in one place.</p>
        </div>
        </<div>

    </div>
</section>

<section class="row align-items-center my-5">
    <div class="container">
    <h2 class="text-center mb-4">Work with clients seamlessly</h2>
    <div class="col-12 text-center">
        <video class="video-placeholder" controls width="80%"></video>
    </div>
    </div>
</section>

<section class="bg-light py-5">
    <div class="container">
    <h2 class="text-center mb-3">CareCompass works for a diverse range of professionals</h2>
    <p class="text-center mb-5">CareCompass is designed for mental health professionals, from independent counselors to large practices and partnered organizations.</p>
    <div class="row text-center">
        <div class="col-md-4 mb-4">
            <img src="images/independentPractitioners.png" alt="Independent practitioners" class="mb-3" width="150" height="150" />
            <h3>Independent Practitioners</h3>
            <p class="text-start">Whether your individual practice sdees clients in person or virtually carecompass will streamline the admin process and make sure you can devote your tiem to what matters, your clients.</p>
        </div>
        <div class="col-md-4 mb-4">
            <img src="images/establishedPractices.png" alt="Established Practices" class="mb-3" width="150" height="150" />
            <h3>Established Practices</h3>
            <p class="text-start">Streamline operations across multiple practitioners, track payments, and maintain a professional standard for every client interaction.</p>
        </div>
        <div class="col-md-4 mb-4">
            <img src="images/otherHealthProviders.png" alt="Other Health Providers" class="mb-3" width="150" height="150" />
            <h3>Other Health Providers</h3>
            <p class="text-start">Currently our platform has been geared toward mental health practitioners, but we are expanding to include other practitioners! Whether you are a chiropractor, RMT, Reiki practitioner, or Doula - soon you'll have the ability to upload your own forms and have the flexibility to adjust documentation to your specific needs!'</p>
        </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
    <h2 class="text-center mb-5">Testimonials</h2>
    <div class="row text-center">
        <div class="col-md-4 mb-4">
            <img class="rounded-circle mb-3" src="images/dr.EmilyChen.png" alt="User Testimonial" width="150" height="150" />
            <h3>Dr. Emily Chen</h3>
            <p class="text-start">“CareCompass has completely transformed the way I manage my practice. Client intake, session notes, and payments are all in one secure dashboard.”</p>
            <blockquote>RCC at Wellness Initiative</blockquote>
        </div>
        <div class="col-md-4 mb-4">
            <img class="rounded-circle mb-3" src="images/michaelPatel.png" alt="User Testimonial" width="150" height="150" />
            <h3>Michael Patel</h3>
            <p class="text-start">“I love how easy it is to track session data and client forms. The dashboard is intuitive, and my clients love the professional feel.”</p>
            <blockquote>Independent Counsellor at Holistic Health</blockquote>
        </div>
        <div class="col-md-4 mb-4">
            <img class="rounded-circle mb-3" src="images/saraGomez.png" alt="User Testimonial" width="150" height="150" />
            <h3>Sara Gomez</h3>
            <p class="text-start">“The booking system and client note organization save me hours every week. Highly recommend CareCompass for any mental health practice.”</p>
            <blockquote>Independent Counselor</blockquote>
        </div>
        </div>
    </div>
</section>