@{
    ViewData["Title"] = "Solution";
}

<section class="hero solution-hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 col-md-6">
                <h1><span class="hero-italic-accent">One solution</span> for a calmer, more connected practice</h1>
                <p>CareCompass brings scheduling, documentation, and client communication into one secure workspace so practitioners can spend less time juggling tools and more time supporting people.</p>

            </div>
            <div class="col-lg-6 col-md-6 mt-4 mt-md-0">
                <div class="solution-image-grid" aria-label="Solution image placeholder options">
                    <div class="solution-image-placeholder placeholder-one">
                        <img src="~/Images/profileManagement.png" alt="Profile Management feature preview" class="img-fluid">
                       
                    </div>
                    <div class="solution-image-placeholder placeholder-two">
                        <img src="~/Images/practitionerDashboard.png" alt="Practitioner Dashboard feature preview" class="img-fluid">
                       
                    </div>
                    <div class="solution-image-placeholder placeholder-three">
                        <img src="~/Images/independentPractitioners.png" alt="Practice Growth feature preview" class="img-fluid">
                     
                    </div>
                    <div class="solution-image-placeholder placeholder-four">
                        <img src="~/Images/documentation&Forms.png" alt="Client Communication feature preview" class="img-fluid">
                       
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="features-section solution-features">
    <div class="container">
        <div class="section-header">
            <h2>Built around the way practices actually work</h2>
            <p>Everything from first contact to follow-up is organized into one thoughtful workflow.</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-card solution-card">
                    <div class="solution-card-number">01</div>
                    <h3>Client onboarding</h3>
                    <p>Share intake forms, collect key information securely, and create a polished first impression before the first session even begins.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card solution-card">
                    <div class="solution-card-number">02</div>
                    <h3>Session management</h3>
                    <p>Keep notes, appointments, and records in one place so daily work feels structured, searchable, and much easier to manage.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card solution-card">
                    <div class="solution-card-number">03</div>
                    <h3>Practice growth</h3>
                    <p>Scale with confidence using tools that support a more consistent client experience across solo, shared, or expanding practices.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="video-section solution-video-section">
    <div class="container">
        <div class="section-header">
            <h2>See the platform in motion</h2>
            <p>A quick product look at the calm, modern workflow behind CareCompass.</p>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="video-wrapper solution-video-wrapper">
                    <video controls preload="metadata" poster="~/Images/video-poster.png" aria-label="CareCompass solution overview video">
                        <source src="~/Images/care-compass-video2.mp4" type="video/mp4" />
                        Your browser does not support the video tag.
                    </video>
                </div>
            </div>
        </div>
    </div>
</section>
